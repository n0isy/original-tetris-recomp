	.TITLE	TETRIS
	.IDENT	/V1.2G/
	.RADIX	8
;
;	TETRIS -- the game itself, 001000..017251 of TETRIS.SAV.
;
;	Output of the OMSI PASCAL-1 compiler, read back from the binary.  The
;	PASCAL source is lost; this is the machine code as it stands, with the
;	structure named where it could be worked out.  Everything the compiler
;	calls is a $Bnn entry point of the run-time system:
;
;		$B74/$B76	enter and leave a procedure (save registers)
;		$B12/$B16	read a line, read a string
;		$B20		write one character
;		$B24		write an integer in a field
;		$B32		write a string in a field
;		$B36		end the line
;		$B86/$B88	real to integer, integer to real
;		$B116		multiply
;
;	R5 points at the program's global variables throughout, so 1337(R5)
;	and the like are fixed offsets into that area, not addresses.
;
;	Text is in KOI-7 N2, where the Cyrillic letters sit in the same codes
;	as the Latin lower case: "ВАШЕ ИМЯ?" is stored as "wa{e imq?".  The
;	Russian is given in the comment beside every string.
;
	.ENABL	GBL			; $Bnn are the run-time system's
	.ENABL	LC			; keep lower case: the Russian lives there
	.GLOBL	$END
$VER	== 14				; compiler version, as PASCAL emits it

	.PSECT

;	KEYIN -- not compiler output.  This one is written by hand in assembler
;	and pulled in as an EXTERNAL procedure, because PASCAL has no way to
;	ask "is a key down" without waiting for one.
;
;	It counts how many times .TTINR had to be tried before a character
;	turned up, and leaves the count in DELAY.  That count is the game's
;	source of randomness: how long the player took to press a key, measured
;	in polling loops.  RANDOM below feeds it straight into a multiply.

KEYIN:	MOV	R1,SAVR1
	CLR	R1
KEYWT:	INC	R1
	EMT	340			; .TTINR
	BCS	KEYWT
	MOVB	R0,@2(SP)
	MOV	R1,DELAY
KEYDRN:	EMT	340			; drain whatever else is queued
	BCC	KEYDRN
	MOV	SAVR1,R1
	BR	KEYRET

DELAY:	.WORD	0
SAVR1:	.WORD	0

KEYRET:	MOV	(SP),2(SP)
	ADD	#2,SP
	RTS	PC

;	RANDOM -- next pseudo-random number.  A plain linear congruential step,
;	DELAY*31425+15415, with the sign bit knocked off; then it is turned
;	into a real, divided by 44000 (2.0 in floating point) and multiplied by
;	the caller's bound.  Note FDIV and FMUL: on an 11/03 these trap and are
;	worked out by $FPSIM.

RANDOM:	SUB	#6,SP
	JSR	R0,$B74
	MOV	DELAY,16(SP)
	MOV	16(SP),-(SP)
	MOV	#31425,-(SP)
	JSR	PC,$B116
	ADD	#15415,(SP)
	MOV	(SP)+,R0
	BIC	#100000,R0
	MOV	R0,16(SP)
	MOV	16(SP),-(SP)
	JSR	PC,$B88
	CLR	-(SP)
	MOV	#44000,-(SP)
	FDIV	SP
	MOV	(SP)+,14(SP)
	MOV	(SP)+,14(SP)
	MOV	14(SP),-(SP)
	MOV	14(SP),-(SP)
	MOV	26(SP),-(SP)
	JSR	PC,$B88
	FMUL	SP
	JSR	PC,$B86
	MOV	(SP)+,24(SP)
	MOV	16(SP),DELAY
	JSR	R0,$B76
	MOV	6(SP),10(SP)
	ADD	#10,SP
	RTS	PC

;	GOTOXY -- VT52 direct cursor address: ESC Y row+40 col+40.

GOTOXY:	MOV	#33,-(SP)		; ESC
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#131,-(SP)		; Y
	CLR	-(SP)
	JSR	PC,$B20
	MOV	2(SP),R0
	ADD	#40,R0
	MOV	R0,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	4(SP),R0
	ADD	#40,R0
	MOV	R0,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	(SP),4(SP)
	ADD	#4,SP
	RTS	PC

;	CLS -- ESC H (home) then ESC J (erase to end of screen).

CLS:	MOV	#33,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#110,-(SP)		; H
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#33,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#112,-(SP)		; J
	CLR	-(SP)
	JSR	PC,$B20
	RTS	PC

;	SCORES -- ask for a name, then show the table of results.
;
;	Three passes over the table of 24 entries: print those that beat the
;	new score, slide the rest down by one to make a hole, then print what
;	is left.  Each entry is 24 bytes; 1352(R5) is where the names begin and
;	1374(R5) the scores.

SCORES:	SUB	#32,SP
	CLR	-(SP)
	MOV	#17,-(SP)
	JSR	PC,GOTOXY
	MOV	#16,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#MSGNAM,-(SP)
	MOV	#11,-(SP)
	MOV	#11,-(SP)
	JSR	PC,$B32
SCWT:	EMT	340
	BCC	SCWT
	MOV	SP,R0
	ADD	#4,R0
	MOV	R0,-(SP)
	MOV	#20,-(SP)
	JSR	PC,$B12
	JSR	PC,$B16
	MOV	34(SP),26(SP)
	MOV	36(SP),24(SP)
	JSR	PC,CLS
	MOV	#1,(SP)
	MOVB	#1,30(SP)
	MOV	#CRLF,-(SP)
	MOV	#2,-(SP)
	MOV	#2,-(SP)
	JSR	PC,$B32
	CLR	-(SP)
	MOVB	1337(R5),(SP)
	CLR	-(SP)
	JSR	PC,$B20
	CLR	-(SP)
	MOVB	1337(R5),(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#MSGHDR,-(SP)
	MOV	#30,-(SP)
	MOV	#30,-(SP)
	JSR	PC,$B32
	JSR	PC,$B36

;	Pass one: entries that stand above the new score.

SC1:	MOV	(SP),-(SP)
	MOV	#24,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	CMP	1374(R0),26(SP)
	BHI	SC2
	CLR	R0
	BR	SC3
SC2:	MOV	#1,R0
SC3:	CMP	(SP),#24
	BLT	SC4
	CLR	R1
	BR	SC5
SC4:	MOV	#1,R1
SC5:	COMB	R1
	BICB	R1,R0
	MOV	(SP),-(SP)
	MOV	#24,-(SP)
	JSR	PC,$B116
	MOV	R5,R1
	ADD	(SP)+,R1
	CMPB	1352(R1),#40
	BNE	SC6
	CLR	R1
	BR	SC7
SC6:	MOV	#1,R1
SC7:	COMB	R1
	BICB	R1,R0
	BNE	SC8
	JMP	SC9
SC8:	MOV	(SP),-(SP)
	MOV	#24,-(SP)
	JSR	PC,$B116
	MOV	R5,R3
	ADD	(SP)+,R3
	ADD	#1352,R3
	CLR	-(SP)
	MOVB	1337(R5),(SP)
	CLR	-(SP)
	JSR	PC,$B20
	CLR	-(SP)
	MOVB	1337(R5),(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	R3,-(SP)
	MOV	#20,-(SP)
	MOV	#20,-(SP)
	JSR	PC,$B32
	MOV	#40,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	20(R3),-(SP)
	MOV	#1,-(SP)
	JSR	PC,$B24
	MOV	#40,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	22(R3),-(SP)
	MOV	#5,-(SP)
	JSR	PC,$B24
	JSR	PC,$B36
	INC	(SP)
	JMP	SC1

;	The new name goes in here, and everything below it moves down.

SC9:	CMPB	4(SP),#40
	BNE	SC10
	JMP	SC14
SC10:	MOV	SP,R3
	ADD	#4,R3
	CLR	-(SP)
	MOVB	1337(R5),(SP)
	CLR	-(SP)
	JSR	PC,$B20
	CLR	-(SP)
	MOVB	1337(R5),(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	R3,-(SP)
	MOV	#20,-(SP)
	MOV	#20,-(SP)
	JSR	PC,$B32
	MOV	#40,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	20(R3),-(SP)
	MOV	#1,-(SP)
	JSR	PC,$B24
	MOV	#40,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	22(R3),-(SP)
	MOV	#5,-(SP)
	JSR	PC,$B24
	MOV	#MSGSTR,-(SP)
	MOV	#3,-(SP)
	MOV	#3,-(SP)
	JSR	PC,$B32
	JSR	PC,$B36
	MOV	SP,R0
	ADD	#2,R0
	MOV	R0,-(SP)
	MOV	#23,-(SP)
	MOV	4(SP),-(SP)
	MOV	2(SP),@4(SP)
SC11:	CMP	@4(SP),(SP)
	BGE	SC12
	JMP	SC13
SC12:	MOV	10(SP),R0
	INC	R0
	MOV	R0,-(SP)
	MOV	#24,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	10(SP),-(SP)
	MOV	#24,-(SP)
	JSR	PC,$B116
	MOV	R5,R1
	ADD	(SP)+,R1
	ADD	#1352,R1
	ADD	#1352,R0
	MOV	#12,R2
SCMOV:	MOV	(R1)+,(R0)+
	DEC	R2
	BNE	SCMOV
	DEC	@4(SP)
	BVS	SC13
	JMP	SC11
SC13:	ADD	#6,SP
	MOV	(SP),-(SP)
	MOV	#24,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	SP,R1
	ADD	#4,R1
	ADD	#1352,R0
	MOV	#12,R2
SCPUT:	MOV	(R1)+,(R0)+
	DEC	R2
	BNE	SCPUT
	INC	(SP)

;	Pass three: whatever is still below.

SC14:	CMP	(SP),#24
	BLT	SC15
	JMP	SC18
SC15:	MOV	(SP),-(SP)
	MOV	#24,-(SP)
	JSR	PC,$B116
	MOV	R5,R3
	ADD	(SP)+,R3
	ADD	#1352,R3
	CMPB	(R3),#40
	BNE	SC16
	JMP	SC17
SC16:	CLR	-(SP)
	MOVB	1337(R5),(SP)
	CLR	-(SP)
	JSR	PC,$B20
	CLR	-(SP)
	MOVB	1337(R5),(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	R3,-(SP)
	MOV	#20,-(SP)
	MOV	#20,-(SP)
	JSR	PC,$B32
	MOV	#40,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	20(R3),-(SP)
	MOV	#1,-(SP)
	JSR	PC,$B24
	MOV	#40,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	22(R3),-(SP)
	MOV	#5,-(SP)
	JSR	PC,$B24
	JSR	PC,$B36
SC17:	INC	(SP)
	JMP	SC14
SC18:	MOV	#17,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	32(SP),36(SP)
	ADD	#36,SP
	RTS	PC

MSGNAM:	.ASCII	/wa{e imq?/<0>		; ВАШЕ ИМЯ?
CRLF:	.ASCII	<15><12><0><0>
MSGHDR:	.ASCII	/imq        urowenx  s~et/<0><0> ; ИМЯ УРОВЕНЬ СЧЕТ
MSGSTR:	.ASCII	/ **/<0>

;	WAIT -- pause for 6(SP) times 10(SP) turns of a loop that watches the
;	console status register, so the speed follows the terminal rather than
;	the processor.

WAIT:	CMP	-(SP),-(SP)
	MOV	#177564,R1
WTRDY:	BIT	#100,(R1)
	BNE	WTRDY
	MOV	@6(SP),R3
WTOUT:	MOV	@10(SP),R0
WTIN:	TST	(R1)
	BPL	WTNXT
WTNXT:	SOB	R0,WTIN
	SOB	R3,WTOUT
	MOV	4(SP),10(SP)
	ADD	#10,SP
	RTS	PC

;	Nine words of 011404.  Nothing found so far refers to them.

	.WORD	11404,11404,11404,11404,11404
	.WORD	11404,11404,11404,11404

ROTATE:	CLR	-(SP)
	MOV	R4,-(SP)
	MOV	SP,R3
	ADD	#6,R3
	MOV	(SP),R0
	MOV	R3,R1
	ADD	#10,R1
	MOV	R0,R2
	ADD	#4,R2
	MOV	#4,R4
ROTCPY:	MOV	(R1)+,(R2)+
	DEC	R4
	BNE	ROTCPY
	MOV	SP,R1
	ADD	#2,R1
	MOV	R1,-(SP)
	MOV	#1,-(SP)
	MOV	#4,-(SP)
	MOV	2(SP),@4(SP)
ROTLP:	CMP	@4(SP),(SP)
	BLE	ROTONE
	JMP	ROTX
ROTONE:	MOV	6(SP),R0
	MOV	10(SP),R1
	ASL	R1
	ADD	R0,R1
	MOV	10(SP),R2
	ASL	R2
	ADD	R3,R2
	MOV	177776(R2),R2
	NEG	R2
	MOV	R2,12(R1)
	INC	@4(SP)
	BVS	ROTX
	JMP	ROTLP
ROTX:	ADD	#6,SP
	MOV	4(SP),24(SP)
	ADD	#24,SP
	RTS	PC

;	SETUP -- build everything the game needs before the first piece falls.
;
;	First the seven shapes are laid out as coordinate pairs, then each is
;	turned three times by ROTATE so that all four orientations are ready
;	made and rotating during play is only a table lookup.  After that come
;	the two side panels and the empty table of results.

SETUP:	SUB	#30,SP
	MOV	R5,R3
	ADD	#46,R3
	MOV	SP,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#4,-(SP)
	MOV	2(SP),@4(SP)
SU1:	CMP	@4(SP),(SP)
	BLE	SU2
	JMP	SU3
SU2:	MOV	6(SP),R0
	ASL	R0
	ADD	R3,R0
	MOV	6(SP),-(SP)
	MOV	#3,-(SP)
	JSR	PC,$B80
	MOV	(SP)+,6(R0)
	MOV	6(SP),R0
	ASL	R0
	ADD	R3,R0
	MOV	6(SP),R1
	BIC	#177776,R1
	NEG	R1
	MOV	R1,177776(R0)
	INC	@4(SP)
	BVS	SU3
	JMP	SU1
SU3:	ADD	#6,SP

	MOV	SP,R0
	ADD	#2,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#4,-(SP)
	MOV	2(SP),@4(SP)
SU4:	CMP	@4(SP),(SP)
	BLE	SU5
	JMP	SU9
SU5:	MOV	10(SP),R3
	ADD	#3,R3
	ASL	R3
	ASL	R3
	ASL	R3
	ASL	R3			; sixteen bytes to a shape
	ADD	R5,R3
	ADD	#26,R3
	MOV	SP,R0
	ADD	#6,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#3,-(SP)
	MOV	2(SP),@4(SP)
SU6:	CMP	@4(SP),(SP)
	BLE	SU7
	JMP	SU8
SU7:	MOV	14(SP),R0
	ASL	R0
	ADD	R3,R0
	CLR	6(R0)
	MOV	14(SP),R0
	ASL	R0
	ADD	R3,R0
	MOV	14(SP),R1
	ADD	#177776,R1
	MOV	R1,177776(R0)
	INC	@4(SP)
	BVS	SU8
	JMP	SU6
SU8:	ADD	#6,SP
	MOV	#1,16(R3)
	MOV	10(SP),R0
	ADD	#177775,R0
	MOV	R0,6(R3)
	INC	@4(SP)
	BVS	SU9
	JMP	SU4
SU9:	ADD	#6,SP

	CLR	144(R5)
	MOV	R5,R0
	ADD	#166,R0
	MOV	R5,R1
	ADD	#66,R1
	MOV	#10,R2
SU10:	MOV	(R0)+,(R1)+
	DEC	R2
	BNE	SU10
	MOV	#1,76(R5)
	MOV	R5,R0
	ADD	#166,R0
	MOV	R5,R1
	ADD	#106,R1
	MOV	#10,R2
SU11:	MOV	(R0)+,(R1)+
	DEC	R2
	BNE	SU11
	MOV	#1,122(R5)
	MOV	#1,(R5)

;	Turn each shape once and file the result away.

	MOV	SP,R0
	MOV	R0,-(SP)
	MOV	#2,-(SP)
	MOV	#4,-(SP)
	MOV	2(SP),@4(SP)
SU12:	CMP	@4(SP),(SP)
	BLE	SU13
	JMP	SU16
SU13:	MOV	SP,R4
	ADD	#6,R4
	MOV	6(SP),R0
	ASL	R0
	ASL	R0
	ASL	R0
	ASL	R0
	ADD	R5,R0
	SUB	#20,SP
	ADD	#26,R0
	MOV	SP,R1
	MOV	#10,R2
SU14:	MOV	(R0)+,(R1)+
	DEC	R2
	BNE	SU14
	JSR	PC,ROTATE
	MOV	6(SP),R0
	ADD	#6,R0
	ASL	R0
	ASL	R0
	ASL	R0
	ASL	R0
	ADD	R5,R0
	MOV	SP,R1
	ADD	#12,R1
	ADD	#26,R0
	MOV	#10,R2
SU15:	MOV	(R1)+,(R0)+
	DEC	R2
	BNE	SU15
	MOV	6(SP),R0
	ASL	R0
	ADD	R5,R0
	MOV	6(SP),R1
	ADD	#6,R1
	MOV	R1,177776(R0)
	MOV	6(SP),R0
	ADD	#6,R0
	ASL	R0
	ADD	R5,R0
	MOV	6(SP),177776(R0)
	INC	@4(SP)
	BVS	SU16
	JMP	SU12
SU16:	ADD	#6,SP

;	And again, for the third and fourth orientations.

	MOV	SP,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#3,-(SP)
	MOV	2(SP),@4(SP)
SU17:	CMP	@4(SP),(SP)
	BLE	SU18
	JMP	SU25
SU18:	MOV	6(SP),R0
	ADD	#4,R0
	ASL	R0
	ASL	R0
	ASL	R0
	ASL	R0
	ADD	R5,R0
	ADD	#26,R0
	MOV	SP,R1
	ADD	#12,R1
	MOV	#10,R2
SU19:	MOV	(R0)+,(R1)+
	DEC	R2
	BNE	SU19
	MOV	6(SP),R0
	ADD	#4,R0
	ASL	R0
	ADD	R5,R0
	MOV	6(SP),-(SP)
	MOV	#3,-(SP)
	JSR	PC,$B78
	ADD	#10,(SP)
	MOV	(SP)+,177776(R0)
	MOV	SP,R0
	ADD	#10,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#3,-(SP)
	MOV	2(SP),@4(SP)
SU20:	CMP	@4(SP),(SP)
	BLE	SU21
	JMP	SU24
SU21:	MOV	SP,R4
	ADD	#14,R4
	SUB	#20,SP
	MOV	SP,R0
	ADD	#40,R0
	MOV	SP,R1
	MOV	#10,R2
SU22:	MOV	(R0)+,(R1)+
	DEC	R2
	BNE	SU22
	JSR	PC,ROTATE
	MOV	14(SP),-(SP)
	MOV	#3,-(SP)
	JSR	PC,$B78
	ADD	#7,(SP)
	ADD	20(SP),(SP)
	MOV	(SP)+,R0
	ASL	R0
	ASL	R0
	ASL	R0
	ASL	R0
	ADD	R5,R0
	MOV	SP,R1
	ADD	#20,R1
	ADD	#26,R0
	MOV	#10,R2
SU23:	MOV	(R1)+,(R0)+
	DEC	R2
	BNE	SU23
	MOV	14(SP),-(SP)
	MOV	#3,-(SP)
	JSR	PC,$B78
	ADD	#7,(SP)
	ADD	20(SP),(SP)
	MOV	(SP)+,R0
	ASL	R0
	ADD	R5,R0
	MOV	14(SP),-(SP)
	MOV	#3,-(SP)
	JSR	PC,$B78
	ADD	#10,(SP)
	ADD	20(SP),(SP)
	MOV	(SP)+,177776(R0)
	INC	@4(SP)
	BVS	SU24
	JMP	SU20
SU24:	ADD	#6,SP
	MOV	6(SP),-(SP)
	MOV	#3,-(SP)
	JSR	PC,$B78
	ADD	#12,(SP)
	MOV	(SP)+,R0
	ASL	R0
	ADD	R5,R0
	MOV	6(SP),R1
	ADD	#4,R1
	MOV	R1,177776(R0)
	INC	@4(SP)
	BVS	SU25
	JMP	SU17
SU25:	ADD	#6,SP

	MOV	SP,R0
	MOV	R0,-(SP)
	CLR	-(SP)
	MOV	#11,-(SP)
	MOV	2(SP),@4(SP)
SU26:	CMP	@4(SP),(SP)
	BLE	SU27
	JMP	SU28
SU27:	MOV	6(SP),R0
	ASL	R0
	ADD	R5,R0
	MOV	6(SP),-(SP)
	MOV	#12,-(SP)
	JSR	PC,$B78
	ADD	#5,(SP)
	MOV	(SP)+,1350(R0)
	INC	@4(SP)
	BVS	SU28
	JMP	SU26
SU28:	ADD	#6,SP

;	The two side panels: a frame drawn in the graphic character kept at
;	1336(R5), with room for the score and the level.

	MOV	SP,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#4,-(SP)
	MOV	2(SP),@4(SP)
SU29:	CMP	@4(SP),(SP)
	BLE	SU30
	JMP	SU31
SU30:	MOV	6(SP),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOVB	1336(R5),R1
	ADD	#54400,R1
	MOV	R1,1136(R0)
	MOV	6(SP),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOVB	1336(R5),R1
	ADD	#54400,R1
	MOV	R1,1174(R0)
	MOV	6(SP),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	#27040,1142(R0)
	MOV	6(SP),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	#56533,1200(R0)
	INC	@4(SP)
	BVS	SU31
	JMP	SU29
SU31:	ADD	#6,SP

	MOVB	1336(R5),R0
	ADD	#54400,R0
	MOV	R0,1174(R5)
	MOVB	1336(R5),R0
	ADD	#54400,R0
	MOV	R0,1232(R5)
	MOV	#20040,1176(R5)
	MOV	#20040,1234(R5)
	MOV	#6415,1200(R5)
	MOV	#6415,1236(R5)
	MOV	R5,R0
	ADD	#1144,R0
	MOV	R0,24(SP)
	MOV	R5,R0
	ADD	#1202,R0
	MOV	R0,26(SP)
	MOV	24(SP),1140(R5)
	MOV	26(SP),1142(R5)

;	Clear the table of results: a blank first byte means the slot is free.

	MOV	SP,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#24,-(SP)
	MOV	2(SP),@4(SP)
SU32:	CMP	@4(SP),(SP)
	BLE	SU33
	JMP	SU34
SU33:	MOV	6(SP),-(SP)
	MOV	#24,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOVB	#40,1352(R0)
	INC	@4(SP)
	BVS	SU34
	JMP	SU32
SU34:	ADD	#6,SP
	ADD	#30,SP
	RTS	PC

;	SIDEBR -- wipe the two lines under the side panels, at columns 53 and
;	54 of row 60, by writing eight blanks over each.

SIDEBR:	CLR	-(SP)
	CLR	-(SP)
	MOVB	1336(R5),(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#131,-(SP)		; Y
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#53,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#60,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#BLANK1,-(SP)
	MOV	#10,-(SP)
	MOV	#10,-(SP)
	JSR	PC,$B32
	CLR	-(SP)
	MOVB	1336(R5),(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#131,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#54,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#60,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#BLANK2,-(SP)
	MOV	#10,-(SP)
	MOV	#10,-(SP)
	JSR	PC,$B32
	ADD	#2,SP
	RTS	PC

BLANK1:	.ASCII	/        /<0><0>
BLANK2:	.ASCII	/        /<0><0>

;	SHOWNX -- draw the piece that comes next, in the side panel.

SHOWNX:	CLR	-(SP)
	JSR	PC,SIDEBR
	MOV	1244(R5),R3
	ASL	R3
	ASL	R3
	ASL	R3
	ASL	R3
	ADD	R5,R3
	ADD	#26,R3
	MOV	SP,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#4,-(SP)
	MOV	2(SP),@4(SP)
SX1:	CMP	@4(SP),(SP)
	BLE	SX2
	JMP	SX3
SX2:	CLR	-(SP)
	MOVB	1336(R5),(SP)		; ESC
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#131,-(SP)		; Y
	CLR	-(SP)
	JSR	PC,$B20
	MOV	6(SP),R0
	ASL	R0
	ADD	R3,R0
	MOV	6(R0),R0
	ADD	#53,R0
	MOV	R0,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	6(SP),R0
	ASL	R0
	ADD	R3,R0
	MOV	177776(R0),R0
	ASL	R0			; two columns to a cell
	ADD	#64,R0
	MOV	R0,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#CELL,-(SP)
	MOV	#2,-(SP)
	MOV	#2,-(SP)
	JSR	PC,$B32
	INC	@4(SP)
	BVS	SX3
	JMP	SX1
SX3:	ADD	#6,SP
	ADD	#177773,1334(R5)
	ADD	#2,SP
	RTS	PC

CELL:	.ASCII	/[]/<0><0>		; a square that is filled

;	NEWGAM -- empty the well and start over.  The playing area is a byte
;	per cell at 530(R5); a row is 26 bytes, and the outermost cells are set
;	to one so that a piece runs into them instead of off the edge.

NEWGAM:	CMP	-(SP),-(SP)
	MOV	SP,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#12,-(SP)
	MOV	2(SP),@4(SP)
NG1:	CMP	@4(SP),(SP)
	BLE	NG2
	JMP	NG6
NG2:	MOV	SP,R0
	ADD	#10,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#24,-(SP)
	MOV	2(SP),@4(SP)
NG3:	CMP	@4(SP),(SP)
	BLE	NG4
	JMP	NG5
NG4:	MOV	14(SP),-(SP)
	MOV	#26,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	ADD	16(SP),R0
	CLRB	530(R0)
	INC	@4(SP)
	BVS	NG5
	JMP	NG3
NG5:	ADD	#6,SP
	INC	@4(SP)
	BVS	NG6
	JMP	NG1
NG6:	ADD	#6,SP

;	The two side walls.

	MOV	SP,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#12,-(SP)
	MOV	2(SP),@4(SP)
NG7:	CMP	@4(SP),(SP)
	BLE	NG8
	JMP	NG9
NG8:	MOV	6(SP),-(SP)
	MOV	#26,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOVB	#1,530(R0)
	MOV	6(SP),-(SP)
	MOV	#26,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOVB	#1,555(R0)
	INC	@4(SP)
	BVS	NG9
	JMP	NG7
NG9:	ADD	#6,SP

;	The floor and the ceiling.

	MOV	SP,R0
	ADD	#2,R0
	MOV	R0,-(SP)
	CLR	-(SP)
	MOV	#25,-(SP)
	MOV	2(SP),@4(SP)
NG10:	CMP	@4(SP),(SP)
	BLE	NG11
	JMP	NG12
NG11:	MOV	R5,R0
	ADD	10(SP),R0
	MOVB	#1,530(R0)
	MOV	R5,R0
	ADD	10(SP),R0
	MOVB	#1,1112(R0)
	INC	@4(SP)
	BVS	NG12
	JMP	NG10
NG12:	ADD	#6,SP

	MOV	SP,R0
	ADD	#2,R0
	MOV	R0,-(SP)
	CLR	-(SP)
	MOV	#24,-(SP)
	MOV	2(SP),@4(SP)
NG13:	CMP	@4(SP),(SP)
	BLE	NG14
	JMP	NG15
NG14:	MOV	10(SP),R0
	ASL	R0
	ADD	R5,R0
	CLR	1260(R0)
	INC	@4(SP)
	BVS	NG15
	JMP	NG13
NG15:	ADD	#6,SP
	CLR	1334(R5)
	CLR	-(SP)
	MOV	#7,-(SP)
	JSR	PC,RANDOM
	MOV	(SP)+,R0
	INC	R0
	MOV	R0,1244(R5)		; which piece comes next
	CLRB	1246(R5)
	CLR	1346(R5)
	ADD	#4,SP
	RTS	PC

;	DRAWFL -- paint the whole well: a filled cell is "[]", an empty one is
;	" .", so the grid stays visible.

DRAWFL:	CMP	-(SP),-(SP)
	MOV	SP,R0
	ADD	#2,R0
	MOV	R0,-(SP)
	MOV	12(SP),-(SP)
	MOV	12(SP),-(SP)
	MOV	2(SP),@4(SP)
DF1:	CMP	@4(SP),(SP)
	BLE	DF2
	JMP	DF9
DF2:	MOV	#33,-(SP)
	MOV	12(SP),-(SP)
	JSR	PC,GOTOXY
	MOV	SP,R0
	ADD	#6,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#12,-(SP)
	MOV	2(SP),@4(SP)
DF3:	CMP	@4(SP),(SP)
	BLE	DF4
	JMP	DF8
DF4:	MOV	14(SP),-(SP)
	MOV	#26,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	ADD	16(SP),R0
	TSTB	530(R0)
	BNE	DF5
	JMP	DF6
DF5:	MOV	#CELL2,-(SP)
	MOV	#2,-(SP)
	MOV	#2,-(SP)
	JSR	PC,$B32
	JMP	DF7
DF6:	MOV	#EMPTY,-(SP)
	MOV	#2,-(SP)
	MOV	#2,-(SP)
	JSR	PC,$B32
DF7:	INC	@4(SP)
	BVS	DF8
	JMP	DF3
DF8:	ADD	#6,SP
	INC	@4(SP)
	BVS	DF9
	JMP	DF1
DF9:	ADD	#6,SP
	MOV	4(SP),10(SP)
	ADD	#10,SP
	RTS	PC

CELL2:	.ASCII	/[]/<0><0>
EMPTY:	.ASCII	/ ./<0><0>		; an empty cell, dotted so the grid shows

;	CANFIT -- would the piece stand at this place?  Walk its four cells and
;	look at the well; the answer comes back as a byte.

CANFIT:	CLR	-(SP)
	JSR	R0,$B74
	MOVB	#1,22(SP)
	MOV	526(R5),R3
	MOV	SP,R0
	ADD	#12,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#4,-(SP)
	MOV	2(SP),@4(SP)
CF1:	CMP	@4(SP),(SP)
	BLE	CF2
	JMP	CF5
CF2:	MOV	20(SP),R0
	ASL	R0
	ADD	R3,R0
	MOV	26(SP),R1
	ADD	177776(R0),R1
	MOV	R1,-(SP)
	MOV	#26,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	20(SP),R1
	ASL	R1
	ADD	R3,R1
	MOV	24(SP),R2
	ADD	6(R1),R2
	ADD	R0,R2
	TSTB	530(R2)
	BNE	CF3
	JMP	CF4
CF3:	CLRB	30(SP)			; something is in the way
	ADD	#6,SP
	JMP	CF6
CF4:	INC	@4(SP)
	BVS	CF5
	JMP	CF1
CF5:	ADD	#6,SP
CF6:	JSR	R0,$B76
	MOV	2(SP),6(SP)
	ADD	#6,SP
	RTS	PC

;	NEWPC -- the next piece becomes the current one, another is drawn at
;	random, and it is placed at the top.  If it does not fit there the game
;	is over: 1254(R5) is set.

NEWPC:	CLR	-(SP)
	JSR	R0,$B74
	MOV	1244(R5),1242(R5)
	CLR	-(SP)
	MOV	#7,-(SP)
	JSR	PC,RANDOM
	MOV	(SP)+,R0
	INC	R0
	MOV	R0,1244(R5)
	MOV	1242(R5),R0
	ASL	R0
	ASL	R0
	ASL	R0
	ASL	R0
	ADD	R5,R0
	ADD	#26,R0
	MOV	R0,526(R5)		; where its four cells are
	MOV	#6,1250(R5)		; starting column
	MOV	#1,1252(R5)		; and row
	CLR	-(SP)
	MOV	1250(R5),-(SP)
	MOV	1252(R5),-(SP)
	JSR	PC,CANFIT
	MOVB	(SP)+,16(SP)
	MOV	526(R5),R3
	MOV	R5,R0
	ADD	#1374,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#4,-(SP)
	MOV	2(SP),@4(SP)
NP1:	CMP	@4(SP),(SP)
	BLE	NP2
	JMP	NP3
NP2:	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	1252(R5),R1
	ADD	#40,R1
	MOV	1374(R5),R2
	ASL	R2
	ADD	R3,R2
	ADD	6(R2),R1
	MOV	1374(R5),R2
	ASL	R2
	ADD	R3,R2
	MOV	1250(R5),R4
	ADD	177776(R2),R4
	ASL	R4
	ADD	#71,R4
	SWAB	R4
	BIC	#377,R4
	ADD	R1,R4
	MOV	R4,1176(R0)
	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R1
	ADD	(SP)+,R1
	MOV	1176(R1),1140(R0)
	INC	@4(SP)
	BVS	NP3
	JMP	NP1
NP3:	ADD	#6,SP
	MOV	1142(R5),-(SP)
	MOV	#36,-(SP)
	MOV	#36,-(SP)
	JSR	PC,$B32
	TSTB	1246(R5)
	BNE	NP4
	JMP	NP5
NP4:	JSR	PC,SHOWNX
NP5:	JSR	R0,$B76
	ADD	#2,SP
	RTS	PC

;	MOVEDN -- one step down.  If it will not go, the piece has landed.

MOVEDN:	MOV	1140(R5),-(SP)
	MOV	#36,-(SP)
	MOV	#36,-(SP)
	JSR	PC,$B32
	CLR	-(SP)
	MOV	1250(R5),-(SP)
	MOV	1252(R5),R0
	INC	R0
	MOV	R0,-(SP)
	JSR	PC,CANFIT
	TSTB	(SP)+
	BNE	MD1
	JMP	MD5
MD1:	MOV	R5,R0
	ADD	#1374,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#4,-(SP)
	MOV	2(SP),@4(SP)
MD2:	CMP	@4(SP),(SP)
	BLE	MD3
	JMP	MD4
MD3:	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R1
	ADD	(SP)+,R1
	MOV	1176(R1),R1
	INC	R1
	MOV	R1,1176(R0)
	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R1
	ADD	(SP)+,R1
	MOV	1176(R1),1140(R0)
	INC	@4(SP)
	BVS	MD4
	JMP	MD2
MD4:	ADD	#6,SP
	INC	1252(R5)
	JMP	MD6
MD5:	MOVB	#1,1254(R5)		; it has landed
MD6:	MOV	1142(R5),-(SP)
	MOV	#36,-(SP)
	MOV	#36,-(SP)
	JSR	PC,$B32
	DEC	1334(R5)
	RTS	PC

;	MOVELF -- one column to the left, if there is room.

MOVELF:	MOV	1140(R5),-(SP)
	MOV	#36,-(SP)
	MOV	#36,-(SP)
	JSR	PC,$B32
	CLR	-(SP)
	MOV	1250(R5),R0
	DEC	R0
	MOV	R0,-(SP)
	MOV	1252(R5),-(SP)
	JSR	PC,CANFIT
	TSTB	(SP)+
	BNE	ML1
	JMP	ML5
ML1:	MOV	R5,R0
	ADD	#1374,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#4,-(SP)
	MOV	2(SP),@4(SP)
ML2:	CMP	@4(SP),(SP)
	BLE	ML3
	JMP	ML4
ML3:	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R1
	ADD	(SP)+,R1
	MOV	1176(R1),R1
	ADD	#177000,R1		; two columns back
	MOV	R1,1176(R0)
	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R1
	ADD	(SP)+,R1
	MOV	1176(R1),1140(R0)
	INC	@4(SP)
	BVS	ML4
	JMP	ML2
ML4:	ADD	#6,SP
	DEC	1250(R5)
	CLRB	1254(R5)
ML5:	MOV	1142(R5),-(SP)
	MOV	#36,-(SP)
	MOV	#36,-(SP)
	JSR	PC,$B32
	RTS	PC

;	MOVERT -- and one column to the right.

MOVERT:	MOV	1140(R5),-(SP)
	MOV	#36,-(SP)
	MOV	#36,-(SP)
	JSR	PC,$B32
	CLR	-(SP)
	MOV	1250(R5),R0
	INC	R0
	MOV	R0,-(SP)
	MOV	1252(R5),-(SP)
	JSR	PC,CANFIT
	TSTB	(SP)+
	BNE	MR1
	JMP	MR5
MR1:	MOV	R5,R0
	ADD	#1374,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#4,-(SP)
	MOV	2(SP),@4(SP)
MR2:	CMP	@4(SP),(SP)
	BLE	MR3
	JMP	MR4
MR3:	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R1
	ADD	(SP)+,R1
	MOV	1176(R1),R1
	ADD	#1000,R1
	MOV	R1,1176(R0)
	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R1
	ADD	(SP)+,R1
	MOV	1176(R1),1140(R0)
	INC	@4(SP)
	BVS	MR4
	JMP	MR2
MR4:	ADD	#6,SP
	INC	1250(R5)
	CLRB	1254(R5)
MR5:	MOV	1142(R5),-(SP)
	MOV	#36,-(SP)
	MOV	#36,-(SP)
	JSR	PC,$B32
	RTS	PC

;	ROTPC -- turn the piece.  The four orientations are chained: each shape
;	knows which one follows it, so turning is a lookup.  If the new shape
;	will not fit where it stands, the old one is put back.

ROTPC:	CLR	-(SP)
	MOV	526(R5),(SP)		; remember where we were
	MOV	1242(R5),R0
	ASL	R0
	ADD	R5,R0
	MOV	177776(R0),R0
	ASL	R0
	ASL	R0
	ASL	R0
	ASL	R0
	ADD	R5,R0
	ADD	#26,R0
	MOV	R0,526(R5)
	MOV	1140(R5),-(SP)
	MOV	#36,-(SP)
	MOV	#36,-(SP)
	JSR	PC,$B32
	CLR	-(SP)
	MOV	1250(R5),-(SP)
	MOV	1252(R5),-(SP)
	JSR	PC,CANFIT
	TSTB	(SP)+
	BNE	RP1
	JMP	RP8
RP1:	MOV	526(R5),R3
	MOV	R5,R0
	ADD	#1374,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#4,-(SP)
	MOV	2(SP),@4(SP)
RP2:	CMP	@4(SP),(SP)
	BLE	RP3
	JMP	RP4
RP3:	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	1252(R5),R1
	ADD	#40,R1
	MOV	1374(R5),R2
	ASL	R2
	ADD	R3,R2
	ADD	6(R2),R1
	MOV	1374(R5),R2
	ASL	R2
	ADD	R3,R2
	MOV	1250(R5),R4
	ADD	177776(R2),R4
	ASL	R4
	ADD	#71,R4
	SWAB	R4
	BIC	#377,R4
	ADD	R1,R4
	MOV	R4,1176(R0)
	INC	@4(SP)
	BVS	RP4
	JMP	RP2
RP4:	ADD	#6,SP
	MOV	1242(R5),R0
	ASL	R0
	ADD	R5,R0
	MOV	177776(R0),1242(R5)
	MOV	R5,R0
	ADD	#1374,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#4,-(SP)
	MOV	2(SP),@4(SP)
RP5:	CMP	@4(SP),(SP)
	BLE	RP6
	JMP	RP7
RP6:	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R1
	ADD	(SP)+,R1
	MOV	1176(R1),1140(R0)
	INC	@4(SP)
	BVS	RP7
	JMP	RP5
RP7:	ADD	#6,SP
	CLRB	1254(R5)
	JMP	RP9
RP8:	MOV	(SP),526(R5)		; would not fit -- put it back
RP9:	MOV	1142(R5),-(SP)
	MOV	#36,-(SP)
	MOV	#36,-(SP)
	JSR	PC,$B32
	ADD	#2,SP
	RTS	PC

;	DROP -- straight to the bottom: keep stepping down while it still fits,
;	then mark the piece as landed.

DROP:	CLR	-(SP)
	MOV	1252(R5),(SP)		; the row it started from
DR1:	CLR	-(SP)
	MOV	1250(R5),-(SP)
	MOV	1252(R5),R0
	INC	R0
	MOV	R0,-(SP)
	JSR	PC,CANFIT
	TSTB	(SP)+
	BNE	DR2
	JMP	DR3
DR2:	INC	1252(R5)
	JMP	DR1
DR3:	MOV	R5,R0
	ADD	#1374,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#4,-(SP)
	MOV	2(SP),@4(SP)
DR4:	CMP	@4(SP),(SP)
	BLE	DR5
	JMP	DR6
DR5:	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R1
	ADD	(SP)+,R1
	MOV	1176(R1),1140(R0)
	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	1374(R5),-(SP)
	MOV	#6,-(SP)
	JSR	PC,$B116
	MOV	R5,R1
	ADD	(SP)+,R1
	MOV	1252(R5),R2
	SUB	6(SP),R2		; how far it fell
	ADD	1176(R1),R2
	MOV	R2,1176(R0)
	INC	@4(SP)
	BVS	DR6
	JMP	DR4
DR6:	ADD	#6,SP
	MOV	1140(R5),-(SP)
	MOV	#36,-(SP)
	MOV	#36,-(SP)
	JSR	PC,$B32
	MOV	1142(R5),-(SP)
	MOV	#36,-(SP)
	MOV	#36,-(SP)
	JSR	PC,$B32
	MOVB	#1,1254(R5)
	ADD	#2,SP
	RTS	PC

;	CLRNXT -- rub out the box where the next piece is shown: six lines,
;	each cleared from column 64 with ESC K.

CLRNXT:	CLR	-(SP)
	MOV	SP,R0
	MOV	R0,-(SP)
	CLR	-(SP)
	MOV	#6,-(SP)
	MOV	2(SP),@4(SP)
CN1:	CMP	@4(SP),(SP)
	BLE	CN2
	JMP	CN3
CN2:	MOV	#64,-(SP)
	MOV	10(SP),R0
	ADD	#2,R0
	MOV	R0,-(SP)
	JSR	PC,GOTOXY
	CLR	-(SP)
	MOVB	1336(R5),(SP)		; ESC
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#113,-(SP)		; K -- erase to end of line
	CLR	-(SP)
	JSR	PC,$B20
	INC	@4(SP)
	BVS	CN3
	JMP	CN1
CN3:	ADD	#6,SP
	ADD	#2,SP
	RTS	PC

;	SPDUP -- one level faster: the pause between steps gets shorter.

SPDUP:	INC	1332(R5)
	ADD	#177742,1240(R5)
	RTS	PC

;	KEY -- take a key and do what it says.  The keys are the numeric pad:
;	7 and 9 move, 8 turns, 5 or space drops.

KEY:	CLR	-(SP)
	CLRB	(SP)
	EMT	340			; .TTINR
	BCS	KY1
	MOVB	R0,0(SP)
KY1:	EMT	340			; swallow the rest
	BCC	KY1
	MOVB	(SP),R0
	SUB	#40,R0
	BGE	KY2
	JMP	KEYIGN
KY2:	CMP	#31,R0
	BGE	KY3
	JMP	KEYIGN
KY3:	ASL	R0
	JMP	@JMPTAB(R0)

KEYDRP:	JSR	PC,DROP
	JMP	KEYX
KEYLFT:	JSR	PC,MOVELF
	JMP	KEYX
KEYROT:	JSR	PC,ROTPC
	JMP	KEYX
KEYRGT:	JSR	PC,MOVERT
	JMP	KEYX
KEYNXT:	COMB	1246(R5)
	BICB	#177776,1246(R5)
	TSTB	1246(R5)
	BNE	KN1
	JMP	KN2
KN1:	JSR	PC,SHOWNX
	JMP	KN3
KN2:	JSR	PC,SIDEBR
KN3:	JMP	KEYX
KEYSPD:	CMP	1332(R5),#11
	BLT	KS1
	JMP	KS2
KS1:	JSR	PC,SPDUP
KS2:	JMP	KEYX
KEYNOP:	JMP	KEYX
KEYCLR:	JSR	PC,CLRNXT
	JMP	KEYX
KEYIGN:	JMP	KEYX

;	Where each key goes, indexed by the character less 40.

JMPTAB:	.WORD	KEYDRP			; space -- drop
	.WORD	KEYIGN,KEYIGN,KEYIGN,KEYIGN,KEYIGN
	.WORD	KEYIGN,KEYIGN,KEYIGN,KEYIGN,KEYIGN
	.WORD	KEYIGN,KEYIGN,KEYIGN,KEYIGN,KEYIGN
	.WORD	KEYCLR			; 0
	.WORD	KEYNXT			; 1 -- show or hide the next piece
	.WORD	KEYNOP			; 2
	.WORD	KEYNOP			; 3
	.WORD	KEYSPD			; 4 -- faster
	.WORD	KEYDRP			; 5 -- drop
	.WORD	KEYIGN			; 6
	.WORD	KEYLFT			; 7 -- left
	.WORD	KEYROT			; 8 -- turn
	.WORD	KEYRGT			; 9 -- right

KEYX:	ADD	#2,SP
	RTS	PC

;	TITLE -- the opening screen, and the question that sets the speed.
;	Character 16 is SO and 17 is SI: KOI-7 switches to Russian and back.

TITLE:	JSR	PC,CLS
	MOV	#43,-(SP)
	MOV	#6,-(SP)
	JSR	PC,GOTOXY
	MOV	#BRK1,-(SP)
	MOV	#3,-(SP)
	MOV	#3,-(SP)
	JSR	PC,$B32
	MOV	#43,-(SP)
	MOV	#7,-(SP)
	JSR	PC,GOTOXY
	MOV	#16,-(SP)		; SO
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#TITLE1,-(SP)
	MOV	#13,-(SP)
	MOV	#13,-(SP)
	JSR	PC,$B32
	MOV	#17,-(SP)		; SI
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#53,-(SP)
	MOV	#10,-(SP)
	JSR	PC,GOTOXY
	MOV	#BRK2,-(SP)
	MOV	#3,-(SP)
	MOV	#3,-(SP)
	JSR	PC,$B32
	MOV	#24,-(SP)
	MOV	#24,-(SP)
	JSR	PC,GOTOXY
	MOV	#16,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#ASKLVL,-(SP)
	MOV	#25,-(SP)
	MOV	#25,-(SP)
	JSR	PC,$B32
	MOV	#17,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	R5,R0
	ADD	#1342,R0
	MOV	R0,-(SP)
	JSR	PC,KEYIN
	MOVB	1342(R5),R0
	SUB	#60,R0			; the digit that was typed
	MOV	R0,1332(R5)
	TST	1332(R5)
	BLT	TT1
	JMP	TT2
TT1:	CLR	1332(R5)
TT2:	CMP	1332(R5),#11
	BGT	TT3
	JMP	TT4
TT3:	MOV	#11,1332(R5)
TT4:	MOV	1332(R5),-(SP)
	MOV	#177742,-(SP)
	JSR	PC,$B78
	ADD	#423,(SP)
	MOV	(SP)+,1240(R5)		; the pause between steps
	RTS	PC

BRK1:	.ASCII	/[ ]/<0>
TITLE1:	.ASCII	/t e t r i s/<0>	; Т Е Т Р И С
BRK2:	.ASCII	/[ ]/<0>
ASKLVL:	.ASCII	/wa{ urowenx? (0-9) - /<0>  ; ВАШ УРОВЕНЬ? (0-9) -

;	LOCKPC -- the piece has come to rest.  Its four cells are written into
;	the well, the count of filled cells in each row goes up, and the score
;	grows by 31 plus three times the level.

LOCKPC:	CLR	-(SP)
	MOV	526(R5),R3
	MOV	SP,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#4,-(SP)
	MOV	2(SP),@4(SP)
LK1:	CMP	@4(SP),(SP)
	BLE	LK2
	JMP	LK3
LK2:	MOV	6(SP),R0
	ASL	R0
	ADD	R3,R0
	MOV	1250(R5),R1
	ADD	177776(R0),R1
	MOV	R1,-(SP)
	MOV	#26,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	MOV	6(SP),R1
	ASL	R1
	ADD	R3,R1
	MOV	1252(R5),R2
	ADD	6(R1),R2
	ADD	R0,R2
	MOVB	#1,530(R2)
	MOV	6(SP),R0
	ASL	R0
	ADD	R3,R0
	MOV	1252(R5),R1
	ADD	6(R0),R1
	ASL	R1
	ADD	R5,R1
	MOV	6(SP),R0
	ASL	R0
	ADD	R3,R0
	MOV	1252(R5),R2
	ADD	6(R0),R2
	ASL	R2
	ADD	R5,R2
	MOV	1260(R2),R0
	INC	R0
	MOV	R0,1260(R1)		; one more cell in that row
	INC	@4(SP)
	BVS	LK3
	JMP	LK1
LK3:	ADD	#6,SP
	MOV	1334(R5),R0
	ADD	#31,R0
	MOV	1332(R5),-(SP)
	MOV	#3,-(SP)
	JSR	PC,$B116
	ADD	(SP)+,R0
	MOV	R0,1334(R5)
	ADD	#2,SP
	RTS	PC

;	CLRROW -- take out the rows that came out full.  A row is full when its
;	count reaches 12.  Everything above it slides down one, and the run of
;	completed rows is counted so that the level can go up.

CLRROW:	SUB	#14,SP
	CLR	10(SP)
	MOV	SP,R0
	MOV	R0,-(SP)
	MOV	#24,-(SP)
	MOV	#1,-(SP)
	MOV	2(SP),@4(SP)
CR1:	CMP	@4(SP),(SP)
	BGE	CR2
	JMP	CR5
CR2:	MOV	6(SP),R0
	ASL	R0
	ADD	R5,R0
	CMP	1260(R0),#12
	BEQ	CR3
	JMP	CR4
CR3:	MOV	6(SP),16(SP)
	ADD	#6,SP
	JMP	CR6
CR4:	DEC	@4(SP)
	BVS	CR5
	JMP	CR1
CR5:	ADD	#6,SP
CR6:	TST	10(SP)
	BEQ	CR7
	JMP	CR8
CR7:	CLR	R4			; nothing was full
	JMP	CR36
CR8:	MOV	10(SP),4(SP)
	MOV	10(SP),2(SP)
CR9:	MOV	2(SP),R0
	ASL	R0
	ADD	R5,R0
	TST	1260(R0)
	BNE	CR10
	CLR	R0
	BR	CR11
CR10:	MOV	#1,R0
CR11:	TST	2(SP)
	BGT	CR12
	CLR	R1
	BR	CR13
CR12:	MOV	#1,R1
CR13:	COMB	R1
	BICB	R1,R0
	BNE	CR14
	JMP	CR29
CR14:	MOV	2(SP),R0
	ASL	R0
	ADD	R5,R0
	CMP	1260(R0),#12
	BNE	CR15
	JMP	CR19
CR15:	MOV	SP,R0
	ADD	#12,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#12,-(SP)
	MOV	2(SP),@4(SP)
CR16:	CMP	@4(SP),(SP)
	BLE	CR17
	JMP	CR18
CR17:	MOV	20(SP),-(SP)
	MOV	#26,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	ADD	16(SP),R0
	MOV	20(SP),-(SP)
	MOV	#26,-(SP)
	JSR	PC,$B116
	MOV	R5,R1
	ADD	(SP)+,R1
	ADD	10(SP),R1
	MOVB	530(R1),530(R0)
	INC	@4(SP)
	BVS	CR18
	JMP	CR16
CR18:	ADD	#6,SP
	MOV	10(SP),R0
	ASL	R0
	ADD	R5,R0
	MOV	2(SP),R1
	ASL	R1
	ADD	R5,R1
	MOV	1260(R1),1260(R0)
	DEC	10(SP)
	JMP	CR28

;	A full row is shown blanked out for a moment before it goes.

CR19:	MOV	#33,-(SP)
	MOV	4(SP),-(SP)
	JSR	PC,GOTOXY
	MOV	SP,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#12,-(SP)
	MOV	2(SP),@4(SP)
CR20:	CMP	@4(SP),(SP)
	BLE	CR21
	JMP	CR22
CR21:	MOV	#CELL3,-(SP)
	MOV	#2,-(SP)
	MOV	#2,-(SP)
	JSR	PC,$B32
	INC	@4(SP)
	BVS	CR22
	JMP	CR20
CR22:	ADD	#6,SP
	INC	1346(R5)		; one more full row this game
	MOV	1332(R5),R0
	ASL	R0
	ADD	R5,R0
	CMP	1346(R5),1350(R0)
	BGT	CR23
	CLR	R0
	BR	CR24
CR23:	MOV	#1,R0
CR24:	CMP	1332(R5),#11
	BLT	CR25
	CLR	R1
	BR	CR26
CR25:	MOV	#1,R1
CR26:	COMB	R1
	BICB	R1,R0
	BNE	CR27
	JMP	CR28
CR27:	MOV	#7,-(SP)		; BEL
	CLR	-(SP)
	JSR	PC,$B20
	JSR	PC,SPDUP
CR28:	DEC	2(SP)
	JMP	CR9

;	Then the rows that were taken out are cleared at the top.

CR29:	MOV	SP,R0
	ADD	#6,R0
	MOV	R0,-(SP)
	MOV	4(SP),R0
	INC	R0
	MOV	R0,-(SP)
	MOV	14(SP),-(SP)
	MOV	2(SP),@4(SP)
CR30:	CMP	@4(SP),(SP)
	BLE	CR31
	JMP	CR35
CR31:	MOV	SP,R0
	ADD	#20,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#12,-(SP)
	MOV	2(SP),@4(SP)
CR32:	CMP	@4(SP),(SP)
	BLE	CR33
	JMP	CR34
CR33:	MOV	26(SP),-(SP)
	MOV	#26,-(SP)
	JSR	PC,$B116
	MOV	R5,R0
	ADD	(SP)+,R0
	ADD	22(SP),R0
	CLRB	530(R0)
	INC	@4(SP)
	BVS	CR34
	JMP	CR32
CR34:	ADD	#6,SP
	MOV	14(SP),R0
	ASL	R0
	ADD	R5,R0
	CLR	1260(R0)
	INC	@4(SP)
	BVS	CR35
	JMP	CR30
CR35:	ADD	#6,SP
	MOV	2(SP),-(SP)
	MOV	6(SP),-(SP)
	JSR	PC,DRAWFL
	BR	CR37
CR36:	ADD	R4,SP
CR37:	ADD	#14,SP
	RTS	PC

CELL3:	.ASCII	/ ./<0><0>

;	REPORT -- how it went: rows, level and score.  The score is shown as
;	thousands and remainder, with a "$" for each thousand.

REPORT:	CLR	-(SP)
	CLR	-(SP)
	CLR	-(SP)
	JSR	PC,GOTOXY
	MOV	#16,-(SP)		; SO
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#MSGLIN,-(SP)
	MOV	#17,-(SP)
	MOV	#17,-(SP)
	JSR	PC,$B32
	MOV	1346(R5),-(SP)
	MOV	#3,-(SP)
	JSR	PC,$B24
	MOV	#MSGLVL,-(SP)
	MOV	#17,-(SP)
	MOV	#17,-(SP)
	JSR	PC,$B32
	MOV	1332(R5),-(SP)
	MOV	#3,-(SP)
	JSR	PC,$B24
	MOV	#MSGSCO,-(SP)
	MOV	#13,-(SP)
	MOV	#13,-(SP)
	JSR	PC,$B32
	MOV	1334(R5),-(SP)
	MOV	#1750,-(SP)
	JSR	PC,$B120
	MOV	#3,-(SP)
	JSR	PC,$B24
	MOV	#17,-(SP)		; SI
	CLR	-(SP)
	JSR	PC,$B20
	JSR	PC,$B36
	MOV	SP,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	1334(R5),-(SP)
	MOV	#1750,-(SP)
	JSR	PC,$B118
	MOV	2(SP),@4(SP)
RE1:	CMP	@4(SP),(SP)
	BLE	RE3
	JMP	RE6
RE3:	MOV	#MSGDOL,-(SP)
	MOV	#2,-(SP)
	MOV	#2,-(SP)
	JSR	PC,$B32
	MOV	6(SP),-(SP)
	MOV	#5,-(SP)
	JSR	PC,$B82
	TST	(SP)+
	BEQ	RE4
	JMP	RE5
RE4:	JSR	PC,$B36			; five to a line
RE5:	INC	@4(SP)
	BVS	RE6
	JMP	RE1
RE6:	ADD	#6,SP
	ADD	#2,SP
	RTS	PC

MSGLIN:	.ASCII	<15><12>/polnyh strok:/<0>	; ПОЛНЫХ СТРОК:
MSGLVL:	.ASCII	<15><12>/urowenx:     /<0>	; УРОВЕНЬ:
MSGSCO:	.ASCII	<15><12>/  s~et:  /<0>		; СЧЕТ:
MSGDOL:	.ASCII	/ $/<0><0>

;	HELP -- draw the well and write out what the keys do.

HELP:	CLR	-(SP)
	MOV	SP,R0
	MOV	R0,-(SP)
	MOV	#1,-(SP)
	MOV	#24,-(SP)
	MOV	2(SP),@4(SP)
HP1:	CMP	@4(SP),(SP)
	BLE	HP2
	JMP	HP3
HP2:	MOV	#31,-(SP)
	MOV	10(SP),-(SP)
	JSR	PC,GOTOXY
	MOV	#WELL,-(SP)
	MOV	#30,-(SP)
	MOV	#30,-(SP)
	JSR	PC,$B32
	INC	@4(SP)
	BVS	HP3
	JMP	HP1
HP3:	ADD	#6,SP
	MOV	#31,-(SP)
	MOV	#25,-(SP)
	JSR	PC,GOTOXY
	MOV	#FLOOR,-(SP)
	MOV	#30,-(SP)
	MOV	#30,-(SP)
	JSR	PC,$B32
	MOV	#31,-(SP)
	MOV	#26,-(SP)
	JSR	PC,GOTOXY
	MOV	#WEDGE,-(SP)
	MOV	#26,-(SP)
	MOV	#26,-(SP)
	JSR	PC,$B32
	MOV	#64,-(SP)
	MOV	#2,-(SP)
	JSR	PC,GOTOXY
	MOV	#16,-(SP)		; SO
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#KEYS79,-(SP)
	MOV	#26,-(SP)
	MOV	#26,-(SP)
	JSR	PC,$B32
	MOV	#64,-(SP)
	MOV	#3,-(SP)
	JSR	PC,GOTOXY
	MOV	#KEYS8,-(SP)
	MOV	#17,-(SP)
	MOV	#17,-(SP)
	JSR	PC,$B32
	MOV	#64,-(SP)
	MOV	#4,-(SP)
	JSR	PC,GOTOXY
	MOV	#KEYS45,-(SP)
	MOV	#26,-(SP)
	MOV	#26,-(SP)
	JSR	PC,$B32
	MOV	#64,-(SP)
	MOV	#5,-(SP)
	JSR	PC,GOTOXY
	MOV	#KEYS1,-(SP)
	MOV	#26,-(SP)
	MOV	#26,-(SP)
	JSR	PC,$B32
	MOV	#64,-(SP)
	MOV	#6,-(SP)
	JSR	PC,GOTOXY
	MOV	#KEYS0,-(SP)
	MOV	#26,-(SP)
	MOV	#26,-(SP)
	JSR	PC,$B32
	MOV	#64,-(SP)
	MOV	#7,-(SP)
	JSR	PC,GOTOXY
	MOV	#KEYSSP,-(SP)
	MOV	#23,-(SP)
	MOV	#23,-(SP)
	JSR	PC,$B32
	MOV	#17,-(SP)		; SI
	CLR	-(SP)
	JSR	PC,$B20
	ADD	#2,SP
	RTS	PC

WELL:	.ASCII	/<! . . . . . . . . . .!>/<0><0>
FLOOR:	.ASCII	/<!====================!>/<0><0>
WEDGE:	.ASCII	%  \/\/\/\/\/\/\/\/\/\/%<0><0>
KEYS79:	.ASCII	/7: nalewo   9: naprawo/<0><0>	; 7: НАЛЕВО   9: НАПРАВО
KEYS8:	.ASCII	/     8:poworot /<0>		; 8:ПОВОРОТ
KEYS45:	.ASCII	/4:uskoritx  5:sbrositx/<0><0>	; 4:УСКОРИТЬ  5:СБРОСИТЬ
KEYS1:	.ASCII	/1: pokazatx  sledu`}u`/<0><0>	; 1: ПОКАЗАТЬ СЛЕДУЮЩУЮ
KEYS0:	.ASCII	/0:  steretx |tot tekst/<0><0>	; 0: СТЕРЕТЬ ЭТОТ ТЕКСТ
KEYSSP:	.ASCII	/  probel - sbrositx/<0>	; ПРОБЕЛ - СБРОСИТЬ

;	$BEGIN -- where $INIT hands over.  PASCAL puts the body of the program
;	after all of its procedures, so this is the end of the module.
;
;	First the global area is claimed -- 2222 bytes of it -- and R5 is set
;	to point at it for the whole run.  $RESR5 keeps a copy so that the
;	run-time system can find it again after a trap.

$BEGIN::MOV	#2222,-(SP)
	JSR	PC,$B70
	MOV	(SP)+,R5
	MOV	(SP),(R5)+		; the INPUT file block
	MOV	2(SP),(R5)+		; and OUTPUT, left by $INIT
	MOV	R5,$RESR5
	MOVB	#33,1336(R5)		; ESC
	MOVB	#11,1337(R5)		; the character a filled cell is drawn with
	MOV	#27,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#17,-(SP)
	CLR	-(SP)
	JSR	PC,$B20
	JSR	PC,SETUP
	MOV	#60,1256(R5)

PLAY:	JSR	PC,TITLE
	JSR	PC,NEWGAM
	JSR	PC,CLS
	JSR	PC,HELP
	JSR	PC,REPORT
	BIS	#10100,@#44		; JSW: take characters one at a time

;	One piece at a time until there is no room for a new one.

NEWP:	CLR	-(SP)
	JSR	PC,NEWPC
	TSTB	(SP)+
	BNE	PL1
	JMP	OVER
PL1:	CLRB	1254(R5)
FALL:	MOV	R5,R0
	ADD	#1256,R0
	MOV	R0,-(SP)
	MOV	R5,R0
	ADD	#1240,R0
	MOV	R0,-(SP)
	JSR	PC,WAIT
	JSR	PC,KEY
	JSR	PC,MOVEDN
	JSR	PC,KEY
	TSTB	1254(R5)		; has it landed?
	BNE	PL2
	JMP	FALL
PL2:	JSR	PC,LOCKPC
	JSR	PC,CLRROW
	JSR	PC,REPORT
	JMP	NEWP

;	Game over: ring the bell, show the table, and ask for another.

OVER:	MOV	#7,-(SP)		; BEL
	CLR	-(SP)
	JSR	PC,$B20
OV1:	EMT	340
	BCC	OV1
	MOV	1332(R5),-(SP)
	MOV	1334(R5),-(SP)
	JSR	PC,SCORES
	MOV	#14,-(SP)
	MOV	#27,-(SP)
	JSR	PC,GOTOXY
	MOV	#16,-(SP)		; SO
	CLR	-(SP)
	JSR	PC,$B20
	MOV	#MSGAGN,-(SP)
	MOV	#27,-(SP)
	MOV	#27,-(SP)
	JSR	PC,$B32
	JSR	PC,$B0
	MOVB	(SP)+,1342(R5)
	JSR	PC,$B16
	MOV	#17,-(SP)		; SI
	CLR	-(SP)
	JSR	PC,$B20
	CMPB	1342(R5),#144		; д
	BEQ	OV2
	CLR	R0
	BR	OV3
OV2:	MOV	#1,R0
OV3:	CMPB	1342(R5),#104		; Д
	BEQ	OV4
	CLR	R1
	BR	OV5
OV4:	MOV	#1,R1
OV5:	BISB	R0,R1
	BNE	OV6
	JMP	OV7
OV6:	JMP	PLAY
OV7:	JMP	$END

MSGAGN:	.ASCII	%e}e parti`? (da/net) - %<0>	; ЕЩЕ ПАРТИЮ? (ДА/НЕТ) -

	.END
