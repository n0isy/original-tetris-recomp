     INST[11].NAM:='BGT   ';INST[11].TYP:=CBR;
     INST[12].NAM:='BLE   ';INST[12].TYP:=CBR;
     INST[13].NAM:='BHI   ';INST[13].TYP:=CBR;
     INST[14].NAM:='BLOS  ';INST[14].TYP:=CBR;
     INST[15].NAM:='BHIS  ';INST[15].TYP:=CBR;
