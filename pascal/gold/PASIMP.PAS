     INST[26].NAM:='ASR   ';INST[26].TYP:=SINGLE   ;
     INST[27].NAM:='ASRB  ';INST[27].TYP:=SINGLE   ;
     INST[28].NAM:='BIC   ';INST[28].TYP:=DOUBLE   ;
     INST[29].NAM:='BICB  ';INST[29].TYP:=DOUBLE   ;
