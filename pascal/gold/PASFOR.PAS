  (*$A-*)
  (*BAD SWITCHES$L-,C-,T-*)
  (*PROGRAM    P A S F O R    V1.2   *)
LABEL
  99;
CONST
  VERSION = 'PASFOR V1.2';
TABSPACE = 8;
  FEED = 2;
  MAXCH = 114;
  BACKFEED = 1;
  MAXLINE = 57;
  HT = 11B;
  LF = 12B;
  FF = 14B;
  CR = 15B;
 
 
 
 
TYPE
  DOUBLEDECPTRTY = ^DOUBLEDEC;
  LINEPTRTY = ^LINE;
  LISTPTRTY = ^LIST;
  PROCCALLTY = ^PROCCALL;
  PROCSTRUCTY = ^PROCSTRUC;
  LINENRTY = 0..7777B;
  PAGENRTY = 0..77B;
  FILENAME= PACKED ARRAY [1..20] OF CHAR;
  WORD    = PACKED ARRAY [1..10] OF CHAR;
  SYMBOL = (LABELSY,CONSTSY,TYPESY,VARSY,                       (*DECSYM*)
	  FUNCTIONSY,PROCEDURESY,INITPROCSY,                  (*PROSYM*)
	  ENDSY,UNTILSY,ELSESY,THENSY,EXITSY,OFSY,DOSY,EOBSY, (*ENDSYMBOLS*)
	  BEGINSY,CASESY,REPEATSY,IFSY,                (*BEGSYM*)
	  RECORDSY,FORWARDSY,OTHERSY,INTCONST,IDENT,STRGCONST,EXTERNSY,
	  RPARENT,SEMICOLON,POINT,LPARENT,COLON,LBRACK,OTHERSSY(*DELIMITER*));
 
 
  LINE =  RECORD
		  LINENR : LINENRTY;
		  PAGENR : PAGENRTY;
		  CONTLINK : LINEPTRTY
		END;
 
  LIST =  RECORD
		  NAME : WORD;
		  LLINK ,
		  RLINK : LISTPTRTY;
		  FIRST ,
		  LAST  : LINEPTRTY;
		  PROCVAR : 0..2;
		  CALLED,
		  CALLEDBY : PROCCALLTY
		END;
 
  PROCCALL =  RECORD
		      PROCCALLNAME : LISTPTRTY;
		      NEXTPROCCALL : PROCCALLTY;
		      FIRST,
		      LAST : LINEPTRTY
		    END;
 
  DOUBLEDEC =  RECORD
		       PROCORT : LISTPTRTY;
		       NEXTPROC: DOUBLEDECPTRTY
		     END;
 
  PROCSTRUC =  RECORD
		       PROCNAME : LISTPTRTY;
		       NEXTPROCSTRUC : PROCSTRUCTY;
		       LINENR : LINENRTY;
		       PAGENR ,
		       PROCLEVEL: PAGENRTY
		     END;
 
 
 
 
VAR
  OUTFLAG,NEWFLAG,CROSSFLAG,NOTLISTING,
LOWERCASEFLAG,UPPERCASEFLAG,MIDDLECASEFLAG:BOOLEAN;
  INPUT,OUTPUT:TEXT;
  I,
  BUFFLEN,
  BUFFMARK,
  BUFFERPTR,
  BUFFINDEX,
  SPACES,
  LASTSPACES,
  SYLENG,
  CHCNT,
  LEVEL,
  BLOCKNR,
  PROCDEC,
  PAGECNT,
  PAGECNT2,
  INCREMENT,
  MAXINC,
  REALLINCNT,
  LINECNT : INTEGER;
  BUFFER  : ARRAY [1..147] OF CHAR;
  TIMEANDDAY : PACKED ARRAY [1..24] OF CHAR;
  SY      : WORD;
  TOKEN    : SYMBOL;
  PAGEFLAG,
  ERRFLAG,
  OLDSPACES,
  EOB     : BOOLEAN;                    (*EOF-MARKE*)
  CH:CHAR;
  DELSY : ARRAY [' '..'_'] OF SYMBOL;
  RESNUM  : ARRAY [1..11] OF INTEGER;
  RESLIST : ARRAY [1..44] OF WORD;
  RESSY   : ARRAY [1..44] OF SYMBOL;
  ALPHANUM,
  DIGITS,
  LETTERS : SET OF CHAR;
  RELEVANTSYM,
  CASESYM,
  PROSYM,
  DECSYM,
  BEGSYM,
  ENDSYM  : SET OF SYMBOL;
  LISTPTR : LISTPTRTY;
  FIRSTNAME : ARRAY ['A'..'Z'] OF LISTPTRTY;
  PROCSTRUCF,
  PROCSTRUCL : PROCSTRUCTY;
  NEWFIL : TEXT;
  MESSAGE : PACKED ARRAY [1..23] OF CHAR;
 
 
 
 
  PROCEDURE   INITPROCEDURE;
   BEGIN
     RESNUM[1] := 1;
     RESNUM[2] := 1;
     RESNUM[3] := 7;
     RESNUM[4] :=16;
     RESNUM[5] :=27;
     RESNUM[6] :=33;
     RESNUM[7] :=39;
     RESNUM[8] :=41;
     RESNUM[9] :=43;
     RESNUM[10]:=44;
     RESNUM[11]:=45;
     RESLIST[ 1] :='IF        '; RESSY [ 1] := IFSY;      RESLIST[ 2] :='TO        '; RESSY [ 2] := OTHERSY;
     RESLIST[ 3] :='OF        '; RESSY [ 3] := OFSY;      RESLIST[ 4] :='IN        '; RESSY [ 4] := OTHERSY;
     RESLIST[ 5] :='DO        '; RESSY [ 5] := DOSY;      RESLIST[ 6] :='OR        '; RESSY [ 6] := OTHERSY;
     RESLIST[ 7] :='END       '; RESSY [ 7] := ENDSY;     RESLIST[ 8] :='FOR       '; RESSY [ 8] := OTHERSY;
     RESLIST[ 9] :='SET       '; RESSY [ 9] := OTHERSY;   RESLIST[10] :='AND       '; RESSY [10] := OTHERSY;
     RESLIST[11] :='NOT       '; RESSY [11] := OTHERSY;   RESLIST[12] :='VAR       '; RESSY [12] := VARSY;
     RESLIST[13] :='NIL       '; RESSY [13] := OTHERSY;   RESLIST[14] :='DIV       '; RESSY [14] := OTHERSY;
     RESLIST[15] :='MOD       '; RESSY [15] := OTHERSY;   RESLIST[16] :='          '; RESSY [16] := OTHERSY;
     RESLIST[17] :='GOTO      '; RESSY [17] := OTHERSY;   RESLIST[18] :='THEN      '; RESSY [18] := THENSY;
     RESLIST[19] :='ELSE      '; RESSY [19] := ELSESY;    RESLIST[20] :='WITH      '; RESSY [20] := OTHERSY;
     RESLIST[21] :='CASE      '; RESSY [21] := CASESY;    RESLIST[22] :='          '; RESSY [22] := OTHERSY;
     RESLIST[23] :='FILE      '; RESSY [23] := OTHERSY;   RESLIST[24] :='TYPE      '; RESSY [24] := TYPESY;
     RESLIST[25] :='EXIT      '; RESSY [25] := OTHERSY;    RESLIST[26] :='          '; RESSY [26] := OTHERSY;
     RESLIST[27] :='ARRAY     '; RESSY [27] := OTHERSY;   RESLIST[28] :='WHILE     '; RESSY [28] := OTHERSY;
     RESLIST[29] :='CONST     '; RESSY [29] := CONSTSY;   RESLIST[30] :='LABEL     '; RESSY [30] := LABELSY;
     RESLIST[31] :='UNTIL     '; RESSY [31] := UNTILSY;   RESLIST[32] :='BEGIN     '; RESSY [32] := BEGINSY;
     RESLIST[33] :='REPEAT    '; RESSY [33] := REPEATSY;  RESLIST[34] :='DOWNTO    '; RESSY [34] := OTHERSY;
     RESLIST[35] :='PACKED    '; RESSY [35] := OTHERSY;   RESLIST[36] :='ORIGIN    '; RESSY [36] := OTHERSSY;
     RESLIST[37] :='          '; RESSY [37] := OTHERSY;  RESLIST[38] :='RECORD    '; RESSY [38] := RECORDSY;
     RESLIST[39] :='FORTRAN   '; RESSY [39] := EXTERNSY;   RESLIST[40] :='FORWARD   '; RESSY [40] := FORWARDSY;
     RESLIST[41] :='EXTERNAL  '; RESSY [41] := EXTERNSY;   RESLIST[42] :='FUNCTION  '; RESSY [42] := FUNCTIONSY;
     RESLIST[43] :='PROCEDURE '; RESSY [43] := PROCEDURESY;RESLIST[44] := '          '; RESSY[44] := INITPROCSY;
   END;
 
 
 
 
  PROCEDURE  INITPROCEDURE1;
   BEGIN
     PROCDEC:=0;
     PAGEFLAG:=FALSE;
     I := 0;
     BUFFLEN := 0;
     BUFFMARK := 0;
     BUFFERPTR := 2;
     BUFFINDEX := 0;
     REALLINCNT:= 0;
     LINECNT :=0;
     BLOCKNR := 0;
     LEVEL := 0;
     PAGECNT := 1;
     PAGECNT2 := 0;
     INCREMENT := 1;
     EOB  := FALSE;
     ERRFLAG := FALSE;
     OLDSPACES := FALSE;
     CH := ' ';
     SY := '          ';
     MESSAGE := 'ERROR IN BLOCKSTRUCTURE';
     TIMEANDDAY := '                  :  :  ';
     DIGITS := ['0'..'9'];
     LETTERS := ['A'..'Z'];
     ALPHANUM := ['0'..'9','A'..'Z'] (*LETTERS OR DIGITS*);
     DECSYM := [LABELSY..VARSY];
     PROSYM := [FUNCTIONSY..INITPROCSY];
     ENDSYM := [FUNCTIONSY..EOBSY];      (*PROSYM OR ENDSYMBOLS*)
     CASESYM := ENDSYM - [ELSESY]; (*TO ALLOW ELSE CLAUSE IN CASE STATEMENTS*)
     BEGSYM := [BEGINSY..IFSY];
     RELEVANTSYM := [LABELSY..INITPROCSY (*DECSYM OR PROSYM*) ,BEGINSY,FORWARDSY,EXTERNSY,EOBSY];
   END;
 
 
 
 
  PROCEDURE INIT;
  VAR
    CH : CHAR;
    I : INTEGER;
   BEGIN (*INIT*)
     FOR CH := 'A' TO 'Z' DO FIRSTNAME [CH] := NIL;
     FOR CH := ' ' TO '_' DO DELSY [CH] := OTHERSY;
     DELSY ['('] := LPARENT;
     DELSY [')'] := RPARENT;
     DELSY ['['] := LPARENT;
     DELSY [']'] := RPARENT;
     DELSY [';'] := SEMICOLON;
     DELSY ['.'] := POINT;
     DELSY [':'] := COLON;
     FOR I := 1 TO 147 DO BUFFER [I] := ' ';
     I := 0;
     NEW (FIRSTNAME['M']);
     LISTPTR := FIRSTNAME ['M'];
     WITH FIRSTNAME ['M']^ DO
      BEGIN
        NAME := 'MAIN.     ';
        LLINK := NIL;
        RLINK := NIL;
        NEW (FIRST);
        LAST := FIRST;
        PROCVAR := 1;
        WITH LAST^ DO
         BEGIN
	 LINENR := 0; PAGENR := 1;
	 CONTLINK := NIL;
         END;
        NEW (CALLED);
        WITH CALLED^ DO
         BEGIN
	 PROCCALLNAME := FIRSTNAME ['M'];
	 NEXTPROCCALL := NIL;
	 NEW (FIRST);
      WITH FIRST^ DO BEGIN
         LINENR := 0; PAGENR := 1; CONTLINK := NIL;
         END;
	 LAST := FIRST;
         END;
        NEW (CALLEDBY);
        WITH CALLEDBY^ DO
         BEGIN
	 PROCCALLNAME := FIRSTNAME ['M'];
	 NEXTPROCCALL := NIL;
	 NEW (FIRST);
         WITH FIRST^ DO BEGIN
            LINENR := 0; PAGENR := 1 ; CONTLINK := NIL;
           END;
	 LAST := FIRST;
         END;
      END;
     NEW (PROCSTRUCF);
     WITH PROCSTRUCF^ DO
      BEGIN
        PROCNAME := FIRSTNAME ['M'];
        NEXTPROCSTRUC := NIL;
        LINENR   := 0; PAGENR := 1;
 
        PROCLEVEL:= 0;
      END;
     PROCSTRUCL := PROCSTRUCF;
   END (*INIT*) ;
 
 
 
 
 
  PROCEDURE DATUM;
  VAR
    DATUM : PACKED ARRAY [1..9] OF CHAR;
    HOUR,MIN,SEC,I : INTEGER;
    R:REAL;
 
   BEGIN
     DATUM := '         ';
     FOR I := 1 TO 9 DO TIMEANDDAY[I] := DATUM[I];
     R:=TIME;
     HOUR:= TRUNC (R);
     R:=(R-HOUR)*60.0;
     MIN:=TRUNC(R);
     R:=(R-MIN)*60.0;
     SEC:=TRUNC(R);
     TIMEANDDAY[17] := CHR (60B+HOUR DIV 10);
     TIMEANDDAY[18] := CHR (60B+HOUR MOD 10);
     TIMEANDDAY[20] := CHR (60B+MIN DIV 10);
     TIMEANDDAY[21] := CHR (60B+MIN MOD 10);
     TIMEANDDAY[23] := CHR (60B+SEC DIV 10);
     TIMEANDDAY[24] := CHR (60B+SEC MOD 10);
   END;
 
  PROCEDURE HEADER;
 
   BEGIN (*HEADER*)
     PAGECNT2 := PAGECNT2 + 1;
     REALLINCNT := 0;
     IF OUTFLAG AND NOT NOTLISTING THEN BEGIN
      WRITELN(OUTPUT,CHR(FF)(*PAGE*));
      WRITELN (OUTPUT,'PAGE      ',PAGECNT:3,'-',PAGECNT2:3,'    ',TIMEANDDAY);
      WRITELN(OUTPUT);
    END;
   END (*HEADER*) ;
 
 
  PROCEDURE NEWPAGE;
 
   BEGIN (*NEWPAGE*)
     PAGECNT2 := 0;
     PAGECNT := PAGECNT + 1;
     IF NEWFLAG
      THEN
       BEGIN
         WRITE(NEWFIL,CHR(FF)(*PAGE*))
       END;
     HEADER;
     IF EOLN (INPUT) AND NOT EOF(INPUT)
      THEN READLN(INPUT);
     LINECNT := 0;
     REALLINCNT := 0;
   END (*NEWPAGE*) ;
 
 
 
 
  FUNCTION LOG10 (X : INTEGER) : INTEGER;
   BEGIN
     IF X < 10
      THEN LOG10 := 1
      ELSE
      IF X < 100
       THEN LOG10 := 2
       ELSE
       IF X < 1000
        THEN LOG10 := 3
        ELSE LOG10 := 4
   END;
 
  PROCEDURE WRITELINE (POSITION  : INTEGER;SPACESKLUGE:BOOLEAN);
  VAR
    I, J, TABCNT, LSPACES : INTEGER;
 
   BEGIN (*WRITELINE*)
     IF PAGEFLAG
      THEN
       BEGIN
         NEWPAGE;
         PAGEFLAG:=FALSE
       END;
     POSITION := POSITION - 2;
     IF POSITION > 0
      THEN
       BEGIN
         I := BUFFMARK + 1;
         WHILE (BUFFER [I] = ' ') AND (I <= POSITION) DO I := I + 1;
         BUFFMARK := POSITION;
         WHILE (BUFFER [POSITION] = ' ') AND (I < POSITION) DO POSITION := POSITION - 1;
         IF I <= POSITION
	THEN
	 BEGIN
	   IF REALLINCNT = MAXLINE
	    THEN HEADER;
	   LINECNT := LINECNT + 1;
	   REALLINCNT := REALLINCNT + 1;
IF OUTFLAG AND NOT NOTLISTING	    THEN WRITE (OUTPUT,LINECNT * INCREMENT : 5,' ');
	   IF NOT OLDSPACES
	    THEN LASTSPACES := SPACES;
	   IF OUTFLAG AND NOT NOTLISTING
	    THEN WRITE (OUTPUT,' ' : LASTSPACES);
	   IF SPACESKLUGE
	    THEN
	     BEGIN
	       TABCNT:=0;LSPACES:=LASTSPACES
	     END
	    ELSE
	     BEGIN
	       TABCNT := LASTSPACES DIV TABSPACE;
	       LSPACES := LASTSPACES MOD TABSPACE;
	     END;
	   FOR TABCNT := TABCNT DOWNTO 1 DO
	   IF NEWFLAG
	    THEN WRITE (NEWFIL,CHR(HT));
	   FOR LSPACES := LSPACES DOWNTO 1 DO
	   IF NEWFLAG
	    THEN WRITE (NEWFIL,' ');
	   IF (POSITION - I + LASTSPACES + 1) > MAXCH
	    THEN
	     BEGIN
	       IF REALLINCNT = MAXLINE
	        THEN
	         BEGIN
		 FOR I := I TO MAXCH + I - LASTSPACES - 1 DO
		  BEGIN
		    IF OUTFLAG AND NOT NOTLISTING
		     THEN WRITE (OUTPUT,BUFFER[I]);
		    IF NEWFLAG
		     THEN WRITE (NEWFIL,BUFFER[I]);
		    BUFFER [I] := ' ';
		  END;
		 IF OUTFLAG AND NOT NOTLISTING
		  THEN WRITELN(OUTPUT);
		 HEADER;
	         END;
	       REALLINCNT := REALLINCNT + 1;
	     END;
	   FOR I := I TO POSITION DO
	    BEGIN
	      IF OUTFLAG AND NOT NOTLISTING
	       THEN WRITE (OUTPUT,BUFFER [I]);
	      IF NEWFLAG
	       THEN WRITE (NEWFIL,BUFFER[I]);
	      BUFFER [I] := ' ';
	    END;
	   IF NEWFLAG
	    THEN WRITELN(NEWFIL);
	   IF OUTFLAG AND NOT NOTLISTING
	    THEN WRITELN(OUTPUT);
	   IF  (MAXINC = LINECNT)
	    THEN NEWPAGE;
	 END;
       END;
     LASTSPACES := SPACES;
     OLDSPACES := FALSE;
IF (TOKEN = IDENT) AND OUTFLAG AND CROSSFLAG
THEN WITH LISTPTR^.LAST^ DO LINENR:=LINECNT + 1;
   END (*WRITELINE*) ;
 
 
 
 
  PROCEDURE BLOCK;
  VAR
    DOUBLEDECF,
    DOUBLEDECL : DOUBLEDECPTRTY;
    CURPROC : LISTPTRTY;
 
    PROCEDURE GETTOKEN ;
    LABEL
      1;
 
    VAR
      FIRSTBUFPTR:INTEGER;
      OLDSPACESMARK,
      I       : INTEGER;
 
      PROCEDURE READBUFFER(SPACESKLUGE:BOOLEAN);
 
 
        PROCEDURE READLINE;
        LABEL
	2;
 
        VAR
	CH      : CHAR;
 
	PROCEDURE READCH;
	 BEGIN (*READCH*)
	   IF NOT EOF(INPUT)
	    THEN
	     BEGIN
	       READ(INPUT,CH);
	       IF (CH<' ') AND (CH <> CHR(11B(*TAB*)))
	        THEN
	         BEGIN
		 IF CH=CHR(14B(*FORMFEED*))
		  THEN PAGEFLAG:=TRUE;
		 CH:=' '
	         END
	     END
	    ELSE CH:=' '
	 END;
 
         BEGIN (*READLINE*)
	 (* STACK;*)
	  REPEAT
	   WHILE EOLN (INPUT) AND NOT (EOF (INPUT)) DO
	    BEGIN
	      READLN(INPUT);
	      IF REALLINCNT = MAXLINE
	       THEN HEADER;
	      LINECNT := LINECNT + 1;
	      REALLINCNT := REALLINCNT + 1;
	      IF OUTFLAG AND NOT NOTLISTING
	       THEN WRITELN (OUTPUT,  LINECNT * INCREMENT  :5);
	      IF NEWFLAG
	       THEN WRITELN(NEWFIL);
	      IF MAXINC = LINECNT
	       THEN NEWPAGE;
	    END;
	   READCH;
	  UNTIL ((CH <> ' ') AND (CH <> CHR(11B(*TAB*)))) OR (EOF (INPUT));
	 BUFFLEN := 0;
	  REPEAT
	   BUFFLEN := BUFFLEN + 1;
	   IF CH = CHR(11B(*TAB*))
	    THEN
	     REPEAT
	      BUFFER[BUFFLEN]:=' ';
	      BUFFLEN := BUFFLEN + 1
	     UNTIL ((BUFFLEN MOD TABSPACE) = 0) OR (BUFFLEN = 147)
	    ELSE
	    BUFFER [BUFFLEN] := CH;
	   IF (EOLN (INPUT) OR (BUFFLEN = 147))
	    THEN GOTO 2;
	   READCH
	  UNTIL FALSE;
2:
	 IF NOT (EOLN (INPUT))
	  THEN
	   BEGIN
	     WRITELN (*(TTY)*);
	     WRITELN ((*TTY,*)'LINE ',(LINECNT+1)*INCREMENT : 5,'TOO LONG');
	     IF OUTFLAG AND NOT NOTLISTING
	      THEN WRITELN (OUTPUT,' ' : 17,' **** NEXT LINE TOO LONG ****');
	   END
	  ELSE
	  IF NOT (EOF (INPUT))
	   THEN
	    BEGIN
	      READLN(INPUT);
	    END;
	 BUFFERPTR := 1;
	 BUFFMARK := 0;
         END (*READLINE*) ;
 
 
       BEGIN (*READBUFFER*)
         IF BUFFERPTR = BUFFLEN + 2
	THEN
	 BEGIN
	   WRITELINE (BUFFERPTR,SPACESKLUGE);
	   CH := ' ';
	   IF EOF (INPUT)
	    THEN EOB := TRUE
	    ELSE READLINE;
	 END
	ELSE
	 BEGIN
	   CH := BUFFER [BUFFERPTR];
	   IF (CH>='a') AND (CH<='z')
	    THEN
	     BEGIN
	       CH:=CHR(ORD(CH)-(ORD('a')-ORD('A')));
	       IF UPPERCASEFLAG
	        THEN BUFFER[BUFFERPTR]:=CH
	     END;
	   BUFFERPTR := BUFFERPTR + 1;
	 END;
       END (*READBUFFER*) ;
 
 
      PROCEDURE PARENTHESE;
 
      VAR
        OLDSPACESMARK : INTEGER;
 
       BEGIN (*PARENTHESE*)
         OLDSPACESMARK := SPACES;
         IF OLDSPACES
	THEN SPACES := LASTSPACES + BUFFERPTR - 2
	ELSE
	 BEGIN
	   LASTSPACES := SPACES;
	   SPACES := SPACES + BUFFERPTR - 2;
	   OLDSPACES := TRUE;
	 END;
	REPEAT
	 GETTOKEN
	UNTIL TOKEN IN [RPARENT,EOBSY];
         SPACES := OLDSPACESMARK;
         OLDSPACES := TRUE;
         GETTOKEN;
       END (*PARENTHESE*) ;
 
 
 
 
      FUNCTION RESWORD: BOOLEAN ;
      LABEL
        1;
      VAR
        I       : INTEGER;
 
       BEGIN (*RESWORD*)
         RESWORD:= FALSE;
         FOR I:=RESNUM[CHCNT] TO RESNUM [CHCNT + 1] -1 DO
         IF RESLIST[ I ] = SY
	THEN
	 BEGIN
	   RESWORD := TRUE;
	   TOKEN := RESSY [I];
	   GOTO 1;
	 END;
1:
       END (*RESWORD*) ;
 
 
 
 
      PROCEDURE FINDNAME;
      LABEL
        1;
 
      VAR
        PROCPTR : PROCCALLTY;
        LPTR: LISTPTRTY;
        ZPTR : LINEPTRTY;
        RIGHT: BOOLEAN;
        INDEXCH : CHAR;
 
 
        PROCEDURE FINDPROC (COMP : LISTPTRTY);
 
        VAR
	PROCCALLPTR : PROCCALLTY;
 
         BEGIN (*FINDPROC*)
	 WHILE (PROCPTR^.PROCCALLNAME <> COMP) AND (PROCPTR^.NEXTPROCCALL <> NIL) DO
	 PROCPTR := PROCPTR^.NEXTPROCCALL;
	 IF PROCPTR^.PROCCALLNAME = COMP
	  THEN
	   BEGIN
	     ZPTR := PROCPTR^.LAST;
	     NEW (PROCPTR^.LAST);
	     WITH PROCPTR^.LAST^ DO
	      BEGIN
	        LINENR := LINECNT + 1;
	        PAGENR := PAGECNT;
	        CONTLINK := NIL;
	      END;
	     ZPTR^.CONTLINK := PROCPTR^.LAST;
	   END
	  ELSE   (*NEW PROC NAME*)
	   BEGIN
	     PROCCALLPTR := PROCPTR;
	     NEW (PROCPTR);
	     WITH PROCPTR^ DO
	      BEGIN
	        PROCCALLNAME := COMP;
	        NEXTPROCCALL := NIL;
	        ZPTR := PROCCALLPTR^.FIRST;
	        NEW (FIRST);
	        WITH FIRST^ DO
	         BEGIN
		 LINENR := LINECNT + 1;
		 PAGENR := PAGECNT;
		 CONTLINK := NIL;
	         END;
	        (*ZPTR^.CONTLINK := FIRST;*)
	        LAST := FIRST;
	      END;
	     PROCCALLPTR^.NEXTPROCCALL := PROCPTR;
	   END;
         END (*FINDPROC*) ;
 
 
 
 
        PROCEDURE NEWPROCEDURE;
         BEGIN (*NEWPROCEDURE*)
	 WITH LISTPTR^ DO
	  BEGIN
	    PROCVAR := PROCDEC;
	    NEW (CALLEDBY);
	    WITH CALLEDBY^ DO
	     BEGIN
	       PROCCALLNAME := CURPROC;
	       NEXTPROCCALL := NIL;
	       (* ZPTR := LISTPTR^.FIRST; *)
	       NEW (FIRST);
	       WITH FIRST^ DO
	        BEGIN
		LINENR := LINECNT + 1;
		PAGENR := PAGECNT;
		CONTLINK := NIL;
	        END;
	       (*       ZPTR^.CONTLINK := FIRST;*)
	       LAST := FIRST;
	     END;
	    NEW (CALLED);
	    WITH CALLED^ DO
	     BEGIN
	       PROCCALLNAME := FIRSTNAME ['M'];
	       NEXTPROCCALL := NIL;
	       (* ZPTR := LISTPTR^.FIRST; *)
	       NEW (FIRST);
	       WITH FIRST^ DO
	        BEGIN
		LINENR := LINECNT + 1;
		PAGENR := PAGECNT;
		CONTLINK := NIL;
	        END;
                 (*       ZPTR^.CONTLINK := FIRST;
	        *)
	       LAST := FIRST;
	     END;
	  END;
	 NEW (PROCSTRUCL^.NEXTPROCSTRUC);
	 PROCSTRUCL := PROCSTRUCL^.NEXTPROCSTRUC;
	 WITH PROCSTRUCL^ DO
	  BEGIN
	    PROCNAME := LISTPTR;
	    NEXTPROCSTRUC := NIL;
	    LINENR := LINECNT + 1;
	    PAGENR := PAGECNT;
	    PROCLEVEL := LEVEL;
	  END;
         END (*NEWPROCEDURE*) ;
 
 
 
 
       BEGIN (*FINDNAME*)
         INDEXCH := SY [1];
         LISTPTR := FIRSTNAME [INDEXCH];
         WHILE LISTPTR <> NIL DO
	BEGIN
	  LPTR:= LISTPTR;
	  IF SY = LISTPTR^.NAME
	   THEN
	    BEGIN
	      IF OUTFLAG
	       THEN
	        BEGIN
 IF CROSSFLAG THEN BEGIN
		ZPTR := LISTPTR^.LAST;
		NEW (LISTPTR^.LAST);
		WITH LISTPTR^.LAST^ DO
		 BEGIN
		   LINENR := LINECNT + 1;
		   PAGENR := PAGECNT;
		   CONTLINK := NIL;
		 END;
		ZPTR^.CONTLINK := LISTPTR^.LAST;
END;
		IF LISTPTR^.PROCVAR <> 0
		 THEN
		  BEGIN
		    IF LISTPTR^.PROCVAR = 2
		     THEN WHILE CH = ' ' DO
		      BEGIN
		        SYLENG := SYLENG + 1;
		        READBUFFER(FALSE);
		      END;
		    IF (CH <> ':') OR (LISTPTR^.PROCVAR = 1)
		     THEN
		      BEGIN
		        PROCPTR := LISTPTR^.CALLEDBY;
		        FINDPROC (CURPROC);
		        PROCPTR := CURPROC^.CALLED;
		        FINDPROC (LISTPTR);
		      END
		  END
		 ELSE
		 IF PROCDEC <> 0
		  THEN
		   BEGIN
		     IF DOUBLEDECF = NIL
		      THEN
		       BEGIN
		         NEW (DOUBLEDECF);
		         DOUBLEDECL := DOUBLEDECF;
		       END
		      ELSE
		       BEGIN
		         NEW (DOUBLEDECL^.NEXTPROC);
		         DOUBLEDECL := DOUBLEDECL^.NEXTPROC;
		       END;
		     DOUBLEDECL^.NEXTPROC := NIL;
		     DOUBLEDECL^.PROCORT := LISTPTR;
		     NEWPROCEDURE;
		   END;
	        END;
	      GOTO 1;
	    END
	   ELSE
	   IF SY > LISTPTR^.NAME
	    THEN
	     BEGIN
	       LISTPTR:= LISTPTR^.RLINK;
	       RIGHT:= TRUE;
	     END
	    ELSE
	     BEGIN
	       LISTPTR:= LISTPTR^.LLINK;
	       RIGHT:= FALSE;
	     END;
	END;
         IF (PROCDEC <> 0) OR CROSSFLAG
	THEN
	 BEGIN
	   NEW (LISTPTR);
	   WITH LISTPTR^ DO
	    BEGIN
	      NAME := SY;
	      LLINK := NIL;
	      RLINK := NIL;
	    END;
	   IF FIRSTNAME [INDEXCH] = NIL
	    THEN FIRSTNAME [INDEXCH] := LISTPTR
	    ELSE
	    IF RIGHT
	     THEN LPTR^.RLINK := LISTPTR
	     ELSE LPTR^.LLINK := LISTPTR;
	   IF OUTFLAG
	    THEN
	     BEGIN
	       WITH LISTPTR^ DO
	        BEGIN
IF CROSSFLAG THEN BEGIN
		NEW (FIRST);
		WITH FIRST^ DO
		 BEGIN
		   LINENR := LINECNT + 1;
		   PAGENR := PAGECNT;
		   CONTLINK := NIL;
		 END;
END
ELSE
FIRST := NIL;
		LAST := FIRST ;
		IF PROCDEC = 0
		 THEN
		  BEGIN
		    PROCVAR := 0;
		    CALLED := NIL;
		    CALLEDBY := NIL;
		  END
		 ELSE NEWPROCEDURE;
	        END;
	     END;
	 END;
1:
         PROCDEC := 0;
       END (*FINDNAME*) ;
 
 
 
 
     BEGIN (*GETTOKEN*)
       SYLENG := 0;
       WHILE ((CH IN ['_','/',' ','%','$','?','\','!','@','(']) OR (CH = '[')) AND NOT EOB  DO
        BEGIN
	IF (CH = '[') OR (((CH = '(') OR (CH = '/')) AND (BUFFER[BUFFERPTR] = '*'))
	 THEN
	  BEGIN
	    OLDSPACESMARK := SPACES;
	    IF OLDSPACES
	     THEN SPACES := LASTSPACES
	     ELSE  LASTSPACES := SPACES;
	    SPACES := SPACES + BUFFERPTR - 1;
	    OLDSPACES := TRUE;
	     REPEAT
	      READBUFFER(TRUE);
	     UNTIL (((CH = '/') OR (CH = ')')) AND (BUFFER[BUFFERPTR - 2] = '*')) OR (CH = ']')
	      OR EOB;
	    SPACES := OLDSPACESMARK;
	    OLDSPACES := TRUE;
	  END
	 ELSE
	 IF CH = '('
	  THEN GOTO 1;
	READBUFFER(FALSE);
        END;
       IF CH = ''''
        THEN
         BEGIN
	 TOKEN := STRGCONST;
	  REPEAT
	   READBUFFER(FALSE);
	  UNTIL (CH = '''') OR EOB;
	 READBUFFER(FALSE);
         END
        ELSE
        IF CH IN LETTERS
         THEN
	BEGIN
	  FIRSTBUFPTR:=BUFFERPTR - 1;
	  SYLENG := 0;
	   REPEAT
	    SYLENG := SYLENG + 1;
	    IF SYLENG <= 10
	     THEN SY [SYLENG] := CH;
	    READBUFFER(FALSE);
	   UNTIL NOT (CH IN ALPHANUM );
	  FOR I := SYLENG + 1 TO 10 DO SY [I] := ' ';
	  IF SYLENG > 10
	   THEN CHCNT := 10
	   ELSE CHCNT := SYLENG;
	  IF NOT RESWORD
	   THEN
	    BEGIN
	      IF LOWERCASEFLAG
	       THEN FOR I:=FIRSTBUFPTR TO BUFFERPTR - 2 DO
	       IF (BUFFER[I]>='A') AND (BUFFER[I]<='Z')
	        THEN BUFFER[I]:=CHR(ORD(BUFFER[I])-ORD('A') + ORD('a'));
	      TOKEN := IDENT ;
	      FINDNAME;
	    END
	   ELSE
	   IF LOWERCASEFLAG OR MIDDLECASEFLAG
	    THEN
	    FOR I:=FIRSTBUFPTR TO BUFFERPTR - 2 DO
	    IF (BUFFER[I]>='a') AND (BUFFER[I]<='z')
	     THEN BUFFER[I]:=CHR(ORD(BUFFER[I])-ORD('a') + ORD('A'));
	END
         ELSE
         IF CH IN DIGITS
	THEN
	 BEGIN
	    REPEAT
	     READBUFFER(FALSE);
	    UNTIL NOT (CH IN DIGITS);
	   TOKEN := INTCONST;
	   IF CH = 'B'
	    THEN READBUFFER(FALSE)
	    ELSE
	     BEGIN
	       IF CH = '.'
	        THEN
	         BEGIN
		  REPEAT
		   READBUFFER(FALSE)
		  UNTIL NOT (CH IN DIGITS);
		 TOKEN := OTHERSY;
	         END;
	       IF CH = 'E'
	        THEN
	         BEGIN
		 READBUFFER(FALSE);
		 IF CH IN ['+','-']
		  THEN READBUFFER(FALSE);
		 WHILE CH IN DIGITS DO READBUFFER(FALSE);
		 TOKEN := OTHERSY;
	         END;
	     END;
	 END
	ELSE
	IF CH <> ' '
	 THEN
	  BEGIN
	    1
:
	    TOKEN := DELSY [CH];
	    READBUFFER(FALSE);
	    IF TOKEN = LPARENT
	     THEN PARENTHESE
	     ELSE
	     IF (TOKEN = COLON) AND (CH = '=')
	      THEN
	       BEGIN
	         TOKEN := OTHERSY;
	         READBUFFER(FALSE);
	       END;
	  END
	 ELSE TOKEN := EOBSY;
     END (*GETTOKEN*) ;
 
 
 
 
    PROCEDURE RECDEF;
    VAR
      OLDSPACESMARK  : INTEGER;
 
 
      PROCEDURE CASEDEF;
 
      VAR
        OLDSPACESMARK  : INTEGER;
 
 
        PROCEDURE PARENTHESE;
 
        VAR
	OLDSPACESMARK : INTEGER;
 
         BEGIN (*PARENTHESE*)
	 OLDSPACESMARK := SPACES;
	 IF OLDSPACES
	  THEN SPACES := LASTSPACES
	  ELSE LASTSPACES := SPACES;
	 SPACES := SPACES + BUFFERPTR - 2;
	 OLDSPACES := TRUE;
	  REPEAT
	   GETTOKEN;
	   CASE TOKEN OF
	     LBRACK : PARENTHESE;
	     CASESY : CASEDEF;
	     RECORDSY : RECDEF
	    END;
	  UNTIL TOKEN IN [RPARENT,EOBSY];
	 SPACES := OLDSPACESMARK;
	 OLDSPACES := TRUE;
	 GETTOKEN;
         END (*PARENTHESE*) ;
 
 
       BEGIN (*CASEDEF*)
         DELSY ['('] := LBRACK;
         OLDSPACESMARK := SPACES;
         IF OLDSPACES
	THEN SPACES := LASTSPACES
	ELSE LASTSPACES := SPACES;
         SPACES := BUFFERPTR - BUFFMARK + SPACES - SYLENG + 3;
         OLDSPACES := TRUE;
	REPEAT
	 GETTOKEN ;
	 CASE TOKEN OF
	   LBRACK : PARENTHESE;
	   CASESY : CASEDEF;
	   RECORDSY: RECDEF
	  END;
	UNTIL TOKEN IN [ENDSY,RPARENT,EOBSY];
         SPACES := OLDSPACESMARK;
         DELSY ['('] := LPARENT;
       END (*CASEDEF*) ;
 
     BEGIN (*RECDEF*)
       OLDSPACESMARK := SPACES;
       SPACES := BUFFERPTR - BUFFMARK + SPACES - SYLENG - 2 + FEED;
       OLDSPACES := TRUE;
       GETTOKEN;
       WRITELINE ( BUFFERPTR-SYLENG,FALSE);
        REPEAT
         CASE TOKEN OF
	 CASESY : CASEDEF;
	 RECORDSY : RECDEF;
	 (*BAD OTHER LABEL INSTEAD OF ELSE*)
	 ELSE  GETTOKEN
	END;
        UNTIL TOKEN IN [ENDSY,EOBSY];
       WRITELINE (BUFFERPTR-SYLENG,FALSE);
       OLDSPACES := TRUE;
       LASTSPACES := SPACES - FEED;
       SPACES := OLDSPACESMARK;
       GETTOKEN;
     END (*RECDEF*) ;
 
 
 
 
    PROCEDURE ERROR (ERRNR : INTEGER);
     BEGIN (*ERROR*)
       ERRFLAG := TRUE;
       WRITELINE (BUFFERPTR,FALSE);
       IF OUTFLAG AND NOT NOTLISTING
        THEN WRITE (OUTPUT,' ':17,' **** ');
       CASE ERRNR OF
         1 :
         IF OUTFLAG AND NOT NOTLISTING
	THEN WRITELN (OUTPUT,SY,' ? ? ? ',MESSAGE);
         2 :
         IF OUTFLAG AND NOT NOTLISTING
	THEN WRITELN (OUTPUT,'MISSING ''END'' OR ''UNTIL'' ');
         3 :
         IF OUTFLAG AND NOT NOTLISTING
	THEN WRITELN (OUTPUT,'MISSING ''THEN''');
         4 :
         IF OUTFLAG AND NOT NOTLISTING
	THEN WRITELN (OUTPUT,'MISSING ''OF'' TO ''CASE''');
         5 :
         IF OUTFLAG AND NOT NOTLISTING
	THEN WRITELN (OUTPUT,' ONLY ONE ''EXIT'' ALLOWED');
         6 :
         IF OUTFLAG AND NOT NOTLISTING
	THEN WRITELN (OUTPUT,'MISSING ''EXIT'' IN ''LOOP'' ')
        END;
     END (*ERROR*) ;
 
    PROCEDURE STATEMENT (IFFLAG : BOOLEAN);
 
    VAR
      CURBLOCKNR : INTEGER;
 
 
 
      PROCEDURE COMPSTAT;
 
       BEGIN (*COMPSTAT*)
         OLDSPACES := TRUE;
         LASTSPACES := SPACES - BACKFEED;
         SPACES:=SPACES+1;
         GETTOKEN;
         WRITELINE (BUFFERPTR-SYLENG,FALSE);
         (*LOOP *)
	REPEAT
	  REPEAT
	   STATEMENT (FALSE);
	  UNTIL TOKEN IN ENDSYM;
	 IF NOT(TOKEN IN [ENDSY,EOBSY,PROCEDURESY,FUNCTIONSY])
	  THEN
	   BEGIN
	     ERROR (1);
	     GETTOKEN ;
	   END;
	UNTIL TOKEN IN [ENDSY,EOBSY,PROCEDURESY,FUNCTIONSY];
         WRITELINE (BUFFERPTR-SYLENG,FALSE);
         SPACES:=SPACES-1;
         LASTSPACES := SPACES-BACKFEED;
         OLDSPACES := TRUE;
         IF TOKEN = ENDSY
	THEN
	 BEGIN
	   GETTOKEN ;
	   WRITELINE (BUFFERPTR-SYLENG,FALSE);
	 END
	ELSE ERROR (2);
       END (*COMPSTAT*) ;
 
 
 
 
      PROCEDURE CASESTAT  ;
      VAR
        OLDSPACESMARK : INTEGER;
 
       BEGIN (*CASESTAT*)
         OLDSPACES := TRUE;
         LASTSPACES := SPACES-FEED;
         GETTOKEN;
         STATEMENT (FALSE);
         IF TOKEN = OFSY
	THEN WRITELINE (BUFFERPTR,FALSE)
	ELSE ERROR (3);
	(*LOOP *)
	REPEAT
	  REPEAT
	   IF TOKEN<>ELSESY
	    THEN
	     REPEAT
	      GETTOKEN ;
	     UNTIL TOKEN IN (ENDSYM + [COLON]);
	   IF (TOKEN = COLON) OR (TOKEN=ELSESY)
	    THEN
	     BEGIN
	       GETTOKEN;
	       STATEMENT (FALSE);
	     END;
	  UNTIL TOKEN IN CASESYM;
	 IF NOT(TOKEN IN [ENDSY,EOBSY,PROCEDURESY,FUNCTIONSY])
	  THEN
	  ERROR (1);
	UNTIL TOKEN IN [ENDSY,EOBSY,PROCEDURESY,FUNCTIONSY];
         WRITELINE (BUFFERPTR-SYLENG,FALSE);
         LASTSPACES := SPACES-BACKFEED;
         OLDSPACES := TRUE;
         IF TOKEN = ENDSY
	THEN
	 BEGIN
	   GETTOKEN ;
	   WRITELINE (BUFFERPTR-SYLENG,FALSE);
	 END
	ELSE ERROR (2);
       END (*CASESTAT*) ;
 
 
 
 
      PROCEDURE IFSTAT (IFVAR : BOOLEAN);
       BEGIN (*IFSTAT*)
         LASTSPACES := SPACES - FEED;
         SPACES := SPACES - BACKFEED;
         OLDSPACES := TRUE;
         GETTOKEN;
         STATEMENT (FALSE);
         IF TOKEN = THENSY
	THEN
	 BEGIN
	   WRITELINE (BUFFERPTR-SYLENG,FALSE);
	   GETTOKEN;
	   STATEMENT (TRUE);
	 END
	ELSE ERROR (4);
         IF TOKEN = ELSESY
	THEN
	 BEGIN
	   WRITELINE (BUFFERPTR-SYLENG,FALSE);
	   GETTOKEN;
	   STATEMENT (TRUE);
	 END;
         SPACES := SPACES + BACKFEED
       END (*IFSTAT*) ;
 
 
      PROCEDURE LABELSTAT;
 
       BEGIN (*LABELSTAT*)
         LASTSPACES := 0;
         OLDSPACES := TRUE;
         GETTOKEN;
         WRITELINE (BUFFERPTR-SYLENG,FALSE);
       END (*LABELSTAT*) ;
 
 
 
 
      PROCEDURE REPEATSTAT;
       BEGIN (*REPEATSTAT*)
         OLDSPACES := TRUE;
         LASTSPACES := SPACES - BACKFEED;
         GETTOKEN ;
         WRITELINE (BUFFERPTR-SYLENG,FALSE);
         (*LOOP *)
	REPEAT
	  REPEAT
	   STATEMENT (FALSE);
	  UNTIL TOKEN IN ENDSYM;
	 IF NOT(TOKEN IN [UNTILSY,EOBSY,PROCEDURESY,FUNCTIONSY])
	  THEN
	   BEGIN
	     ERROR (1);
	     GETTOKEN ;
	   END;
	UNTIL TOKEN IN [UNTILSY,EOBSY,PROCEDURESY,FUNCTIONSY];
         WRITELINE (BUFFERPTR-SYLENG,FALSE);
         OLDSPACES := TRUE;
         LASTSPACES := SPACES-BACKFEED;
         IF TOKEN = UNTILSY
	THEN
	 BEGIN
	   GETTOKEN;
	   STATEMENT (FALSE);
	 END
	ELSE ERROR (2);
       END (*REPEATSTAT*) ;
 
 
 
 
     BEGIN (*STATEMENT*)
       IF TOKEN = INTCONST
        THEN
         BEGIN
	 GETTOKEN;
	 IF TOKEN = COLON
	  THEN LABELSTAT;
         END;
       IF TOKEN IN BEGSYM
        THEN
         BEGIN
	 BLOCKNR := BLOCKNR + 1;
	 CURBLOCKNR := BLOCKNR;
	 WRITELINE (BUFFERPTR-SYLENG,FALSE);
	 SPACES := SPACES + FEED;
	 CASE TOKEN OF
	   BEGINSY : COMPSTAT;
	   CASESY  : CASESTAT;
	   IFSY    : IFSTAT (IFFLAG);
	   EXITSY:GETTOKEN;
	   REPEATSY : REPEATSTAT
	  END;
	 SPACES := SPACES - FEED;
         END
        ELSE WHILE NOT (TOKEN IN ([SEMICOLON] + ENDSYM)) DO GETTOKEN;
       IF TOKEN = SEMICOLON
        THEN GETTOKEN
        ELSE
        IF TOKEN = DOSY
         THEN
	BEGIN
	  GETTOKEN;
	  STATEMENT (FALSE);
	END;
     END (*STATEMENT*) ;
 
 
 
 
   BEGIN (*BLOCK*)
     DOUBLEDECF := NIL;
     LEVEL := LEVEL + 1;
     CURPROC := LISTPTR;
     SPACES := LEVEL * FEED;
      REPEAT
       GETTOKEN
      UNTIL (TOKEN IN RELEVANTSYM);
     WHILE TOKEN IN DECSYM DO
      BEGIN
        WRITELINE (BUFFERPTR-SYLENG,FALSE);
        SPACES := SPACES - FEED;
        WRITELINE (BUFFERPTR,FALSE);
        SPACES := SPACES + FEED;
         REPEAT
	GETTOKEN ;
	IF TOKEN = RECORDSY
	 THEN RECDEF;
         UNTIL TOKEN IN RELEVANTSYM;
      END;
     WHILE TOKEN IN PROSYM DO
      BEGIN
        WRITELINE (BUFFERPTR-SYLENG,FALSE);
        OLDSPACES := TRUE;
        IF TOKEN <> INITPROCSY
         THEN
	BEGIN
	  IF TOKEN = PROCEDURESY
	   THEN PROCDEC := 1
	   ELSE PROCDEC := 2;
	  GETTOKEN;
	END;
        BLOCK;
        IF TOKEN = SEMICOLON
         THEN GETTOKEN;
      END;
     LEVEL := LEVEL - 1;
     SPACES := LEVEL * FEED;
     IF NOT (TOKEN IN [BEGINSY,FORWARDSY,EXTERNSY])
      THEN
       BEGIN
         ERROR (1);
         WHILE NOT (TOKEN IN [BEGINSY,FORWARDSY,EXTERNSY,EOBSY]) DO GETTOKEN
       END;
     IF TOKEN = BEGINSY
      THEN STATEMENT (FALSE)
      ELSE
       BEGIN
         IF TOKEN = EXTERNSY
	THEN GETTOKEN;
         GETTOKEN
       END;
     IF DOUBLEDECF <> NIL
      THEN
       REPEAT
        DOUBLEDECF^.PROCORT^.PROCVAR := 0;
        DOUBLEDECF := DOUBLEDECF^.NEXTPROC;
       UNTIL  DOUBLEDECF = NIL;
     IF LEVEL = 0
      THEN
       BEGIN
         IF TOKEN <> POINT
	THEN
	 BEGIN
	   WRITELN ((*TTY,*)'MISSING POINT AT PROGRAM END');
	   WRITELN (*(TTY)*);
	   IF OUTFLAG AND NOT NOTLISTING
	    THEN WRITELN (OUTPUT,' ' : 17, ' **** MISSING POINT AT PROGRAM END ****');
	   GETTOKEN;
	 END;
         IF TOKEN <> EOBSY
	THEN
	 REPEAT
	  GETTOKEN
	 UNTIL TOKEN = EOBSY;
       END;
   END (*BLOCK*) ;
 
 
 
 
  PROCEDURE PRINTLISTE;
  VAR
    FIRSTPROC,LASTPROC,
    PRED : LISTPTRTY;
    INDEXCH : CHAR;
 
 
 
    PROCEDURE WRITELINENR (SPACES : INTEGER);
 
    VAR
      LINK : LINEPTRTY;
      COUNT : INTEGER;
 
     BEGIN (*WRITELINENR*)
       COUNT := 0;
       LINK := LISTPTR^.FIRST;
        REPEAT
         IF COUNT = 8
	THEN
	 BEGIN
	   WRITELN(OUTPUT);
	   WRITE (OUTPUT,' ' : SPACES);
	   COUNT := 0;
	 END;
         COUNT := COUNT + 1;
         WITH LINK^ DO
         WRITE(OUTPUT,' ':(10-(LOG10(PAGENR)+LOG10(LINENR*INCREMENT)+1)),
	     PAGENR:1,'.',LINENR*INCREMENT:1);
         LINK := LINK^.CONTLINK;
        UNTIL LINK = NIL;
     END (*WRITELINENR*) ;
 
 
 
 
   BEGIN (*PRINTLISTE*)
     FIRSTPROC := NIL;
     LASTPROC := NIL;
     WITH FIRSTNAME ['M']^ DO
     IF RLINK = NIL
      THEN FIRSTNAME ['M'] := LLINK
      ELSE
       BEGIN
         LISTPTR := RLINK;
         WHILE LISTPTR^.LLINK <> NIL DO LISTPTR := LISTPTR^.LLINK;
         LISTPTR^.LLINK := LLINK;
         FIRSTNAME ['M'] := RLINK;
       END;
     INDEXCH := 'A';
     WHILE (INDEXCH < 'Z') AND (FIRSTNAME [INDEXCH] = NIL) DO INDEXCH := SUCC (INDEXCH);
     IF FIRSTNAME [INDEXCH] <> NIL
      THEN
       BEGIN
IF CROSSFLAG THEN BEGIN
         WRITE(OUTPUT,CHR(FF)(*PAGE*));
         WRITELN(OUTPUT,'CROSS REFERENCE LISTING OF IDENTIFIERS');
         WRITELN(OUTPUT,'************************************');
END;
         FOR INDEXCH := INDEXCH TO 'Z' DO
         WHILE FIRSTNAME [INDEXCH] <> NIL DO
	BEGIN
	  LISTPTR := FIRSTNAME [INDEXCH];
	  WHILE LISTPTR^.LLINK <> NIL DO
	   BEGIN
	     PRED := LISTPTR;
	     LISTPTR := LISTPTR^.LLINK;
	   END;
	  IF LISTPTR = FIRSTNAME [INDEXCH]
	   THEN FIRSTNAME [INDEXCH] := LISTPTR^.RLINK
	   ELSE PRED^.LLINK := LISTPTR^.RLINK;
	  IF LISTPTR^.CALLED <> NIL
	   THEN
	    BEGIN
	      IF FIRSTPROC = NIL
	       THEN
	        BEGIN
		FIRSTPROC := LISTPTR;
		LASTPROC := FIRSTPROC;
		LASTPROC^.CALLED^.PROCCALLNAME := NIL;
	        END
	       ELSE
	        BEGIN
		LASTPROC^.CALLED^.PROCCALLNAME := LISTPTR;
		LASTPROC := LISTPTR;
	        END;
	    END;
IF CROSSFLAG THEN BEGIN
	  WRITELN(OUTPUT);
	  WRITE (OUTPUT,LISTPTR^.NAME:11);
	  WRITELINENR (11);
END;
	END;
         IF FIRSTPROC <> NIL
	THEN
	 BEGIN
	   WRITE(OUTPUT,CHR(FF)(*PAGE*));
	   WRITELN (OUTPUT,'LIST OF PROCEDURES');
	   WRITELN (OUTPUT,'******************');
	   LASTPROC^.CALLED^.PROCCALLNAME := NIL;
	   LASTPROC := FIRSTPROC;
	   WHILE LASTPROC <> NIL DO
	    BEGIN
	      LISTPTR :=LASTPROC;
 
	       BEGIN
	         WRITELN(OUTPUT);WRITELN(OUTPUT);
	       END;
	      WRITE (OUTPUT,LASTPROC^.NAME(*:11*), ' IS CALLED BY:');
	      WITH LASTPROC^ DO
	       REPEAT
	        WRITELN(OUTPUT);
	        WRITE (OUTPUT,' ' (*: 11*),CALLEDBY^.PROCCALLNAME^.NAME(*:11*));
	        LISTPTR^.FIRST := CALLEDBY^.FIRST;
	        WRITELINENR (22);
	        CALLEDBY := CALLEDBY^.NEXTPROCCALL;
	       UNTIL CALLEDBY = NIL;
 
	       BEGIN
	         WRITELN(OUTPUT); WRITELN(OUTPUT)
	       END;
	      IF LASTPROC^.CALLED^.NEXTPROCCALL <> NIL
	       THEN
	        BEGIN
		WRITE (OUTPUT,' ' (*: 11*), ' AND CALLS UP:');
		WITH LASTPROC^.CALLED^ DO
		 REPEAT
		  WRITELN(OUTPUT);
		  WRITE (OUTPUT,' ' (*: 11*),NEXTPROCCALL^.PROCCALLNAME^.NAME:11);
		  LISTPTR^.FIRST := NEXTPROCCALL^.FIRST;
		  WRITELINENR (11);
		  NEXTPROCCALL := NEXTPROCCALL^.NEXTPROCCALL;
		 UNTIL NEXTPROCCALL = NIL;
	        END;
	      LASTPROC := LASTPROC^.CALLED^.PROCCALLNAME;
	    END;
	   WRITE(OUTPUT,CHR(FF)(*PAGE*));
	   WRITELN (OUTPUT,'INDENTED PROCEDURE LISTING');
	   WRITELN (OUTPUT,'**************************');
	   PROCSTRUCL := PROCSTRUCF;
	    REPEAT
	     WRITELN(OUTPUT);
	     WITH PROCSTRUCL^ DO
	     WRITE (OUTPUT,' ':PROCLEVEL*3,PROCNAME^.NAME,
		  ' ':(10-(LOG10(PAGENR)+LOG10(LINENR*INCREMENT)+1)),PAGENR:1,'.',LINENR:1);
	     PROCSTRUCL := PROCSTRUCL^.NEXTPROCSTRUC;
	    UNTIL PROCSTRUCL = NIL;
	 END;
       END;
   END (*PRINTLISTE*) ;
 
 
 
 
  PROCEDURE GETFILES;
  VAR
	STR	: TSTRING;
	CDATA	: CSIDATA;
	OKEY	: BOOLEAN;

   FUNCTION GTLINE	( VAR S : TSTRING)	: BOOLEAN;
   BEGIN
     (*$C	.MCALL	.GTLIN
		MOV	S(%6), %1		;
		MOV	(7)+, -(6)		;
		.BYTE	'*, ^O200		;
		MOV	%6, %2			;
		.GLOBL	LOWSTK,	HISTK		;
		CALL	LOWSTK			;
		MOV	#^O1000, @#^O46		;
		.GTLIN	%1, %2			;
		CLR	@#^O46			;
		CALL	HISTK			;
		TST	(6)+			;
     *)
	GTLINE := S[1]=CHR(0)
   END;
 
 
   BEGIN
      REPEAT
	OKEY := FALSE;
	IF GTLINE (STR)
	   THEN WRITELN (VERSION)
	   ELSE
	    BEGIN
		OKEY := CSI (STR, 'PASPASCRF   ', CDATA);
		IF OKEY THEN
		   WITH CDATA DO
		    BEGIN
		     OKEY := IFLAG[1];
		     NEWFLAG := OFLAG1;
		     OUTFLAG := OFLAG2;
		     IF OKEY THEN INPUT := INN[1];
		     IF NEWFLAG THEN NEWFIL := O1;
		     IF OUTFLAG THEN OUTPUT := O2;
		     LOWERCASEFLAG := SWITCH['L'].GIVEN;
		     UPPERCASEFLAG := SWITCH['U'].GIVEN;
		     MIDDLECASEFLAG := SWITCH['M'].GIVEN;
		     CROSSFLAG := SWITCH['C'].GIVEN;
		     NOTLISTING := SWITCH['N'].GIVEN;
		    END;
		IF NOT OKEY THEN WRITELN ('ILLEGAL COMAND')
	    END
      UNTIL OKEY
   END;
 
 
 
 
 BEGIN (*MAIN*)
   INITPROCEDURE;INITPROCEDURE1;
   INIT;
   GETFILES;
   MAXINC := 9999 DIV INCREMENT ;
   IF MAXINC > 4000
    THEN MAXINC:=4000;
   CH:=' ';
   DATUM;
   HEADER;
   BLOCK;
   WRITELINE (BUFFLEN+2,FALSE);
   IF NOT ERRFLAG
    THEN WRITE ((*TTY,*)'NO ');
   WRITELN ((*TTY,*)MESSAGE);
   IF OUTFLAG
    THEN PRINTLISTE;
   IF NEWFLAG
    THEN CLOSE(NEWFIL);
   IF OUTFLAG
    THEN CLOSE(OUTPUT);
