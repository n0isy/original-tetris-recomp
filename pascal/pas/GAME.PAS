(*$T-,A-*)
PROGRAM TETRIS;
LABEL 1;

TYPE
  VEC4 = ARRAY[1..4] OF INTEGER;
  SHP = RECORD
          DX, DY : VEC4
        END;
  GRP = RECORD
          EY, RC, CH : INTEGER
        END;
  STR30 = PACKED ARRAY[1..30] OF CHAR;
  PAN = RECORD CASE BOOLEAN OF
          FALSE : (G : ARRAY[1..5] OF GRP);
          TRUE  : (S : STR30)
        END;
  PPAN = ^PAN;
  PSHP = ^SHP;
  SCOREC = RECORD
             NAME : PACKED ARRAY[1..16] OF CHAR;
             LVL  : INTEGER;
             SCR  : 0..65535
           END;

VAR
  NXT   : ARRAY[1..19] OF INTEGER;
  SHAPE : ARRAY[1..19] OF SHP;
  CUR   : PSHP;
  WELL  : ARRAY[0..11] OF ARRAY[0..21] OF CHAR;
  ERAP  : PPAN;
  DRWP  : PPAN;
  ERASE : PAN;
  DRAW  : PAN;
  PAUSE : INTEGER;
  CURPC : INTEGER;
  NXTPC : INTEGER;
  SHOWN : BOOLEAN;
  XPOS  : INTEGER;
  YPOS  : INTEGER;
  LANDED: BOOLEAN;
  TICKS : INTEGER;
  CNT   : ARRAY[0..20] OF INTEGER;
  LEVEL : INTEGER;
  SCORE : 0..65535;
  ESCCH : CHAR;
  FILLCH: CHAR;
  PAD2  : PACKED ARRAY[1..2] OF CHAR;
  ANS   : CHAR;
  PAD3  : PACKED ARRAY[1..2] OF CHAR;
  LINES : INTEGER;
  QUOTA : ARRAY[0..9] OF INTEGER;
  CELL  : INTEGER;
  HIGH  : ARRAY[1..20] OF SCOREC;
  JSW ORIGIN 44B : INTEGER;

PROCEDURE KEYIN(VAR C : CHAR);
BEGIN
(*$C
	MOV	%1,SAVR1
	CLR	%1
1$:	INC	%1
	EMT	^O340
	BCS	1$
	MOVB	%0,@C(6)
	MOV	%1,DELAY
2$:	EMT	^O340
	BCC	2$
	MOV	SAVR1,%1
	BR	KEYX
DELAY:	.WORD	0
SAVR1:	.WORD	0
KEYX:
*)
END;

FUNCTION RANDOM(N : INTEGER) : INTEGER;
VAR R : REAL;
    SEED : 0..65535;
BEGIN
(*$C	MOV	DELAY,SEED(6) *)
  SEED := (SEED * 31425B + 15415B) MOD 100000B;
  R := SEED / 32768.0;
  RANDOM := TRUNC(R * N);
(*$C	MOV	SEED(6),DELAY *)
END;

PROCEDURE GOTOXY(COL, ROW : INTEGER);
BEGIN
  WRITE(CHR(33B), 'Y', CHR(ROW+40B), CHR(COL+40B))
END;

PROCEDURE CLS;
BEGIN
  WRITE(CHR(33B), 'H', CHR(33B), 'J')
END;

PROCEDURE SCORES(ALVL, ASCR : INTEGER);
VAR I, J : INTEGER;
    ENTRY : SCOREC;
    PLACED : BOOLEAN;
BEGIN
  GOTOXY(0, 15);
  WRITE(CHR(16B), 'wa{e imq?');
(*$C
1$:	EMT	^O340
	BCC	1$
*)
  READ(ENTRY.NAME);
  READLN;
  ENTRY.SCR := ASCR;
  ENTRY.LVL := ALVL;
  CLS;
  I := 1;
  PLACED := TRUE;
  WRITE('
', FILLCH, FILLCH, 'imq        urowenx  s~et');
  WRITELN;
  WHILE (HIGH[I].SCR > ENTRY.SCR) AND (I < 20) AND (HIGH[I].NAME[1] # ' ') DO
    WITH HIGH[I] DO BEGIN
      WRITE(FILLCH, FILLCH, NAME, ' ', LVL:1, ' ', SCR:5);
      WRITELN;
      I := I + 1
    END;
  IF ENTRY.NAME[1] # ' ' THEN BEGIN
    WITH ENTRY DO BEGIN
      WRITE(FILLCH, FILLCH, NAME, ' ', LVL:1, ' ', SCR:5, ' **');
      WRITELN
    END;
    FOR J := 19 DOWNTO I DO
      HIGH[J+1] := HIGH[J];
    HIGH[I] := ENTRY;
    I := I + 1
  END;
  WHILE I < 20 DO BEGIN
    WITH HIGH[I] DO
      IF NAME[1] # ' ' THEN BEGIN
        WRITE(FILLCH, FILLCH, NAME, ' ', LVL:1, ' ', SCR:5);
        WRITELN
      END;
    I := I + 1
  END;
  WRITE(CHR(17B))
END;

PROCEDURE WAIT(VAR TCK, PAU : INTEGER);
VAR A, B : INTEGER;
BEGIN
(*$C
	MOV	#^O177564,%1
1$:	BIT	#^O100,(1)
	BNE	1$
	MOV	@PAU(6),%3
2$:	MOV	@TCK(6),%0
3$:	TST	(1)
	BPL	4$
4$:	SOB	%0,3$
	SOB	%3,2$
*)
END;

PROCEDURE SETUP;
VAR I, J : INTEGER;
    T : SHP;
    EP, DP : PPAN;

  PROCEDURE ROTATE(S : SHP);
  VAR M : INTEGER;
  BEGIN
    WITH S DO BEGIN
      T.DX := DY;
      FOR M := 1 TO 4 DO
        T.DY[M] := -DX[M]
    END
  END;

BEGIN
  WITH SHAPE[1] DO
    FOR I := 1 TO 4 DO BEGIN
      DY[I] := I DIV 3;
      DX[I] := -(I MOD 2)
    END;
  FOR J := 1 TO 4 DO
    WITH SHAPE[J+3] DO BEGIN
      FOR I := 1 TO 3 DO BEGIN
        DY[I] := 0;
        DX[I] := I-2
      END;
      DY[4] := 1;
      DX[4] := J-3
    END;
  SHAPE[4].DY[4] := 0;
  SHAPE[2] := SHAPE[6];
  SHAPE[2].DY[1] := 1;
  SHAPE[3] := SHAPE[6];
  SHAPE[3].DY[3] := 1;
  NXT[1] := 1;
  FOR I := 2 TO 4 DO BEGIN
    ROTATE(SHAPE[I]);
    SHAPE[I+6] := T;
    NXT[I] := I+6;
    NXT[I+6] := I
  END;
  FOR I := 1 TO 3 DO BEGIN
    T := SHAPE[I+4];
    NXT[I+4] := I*3+8;
    FOR J := 1 TO 3 DO BEGIN
      ROTATE(T);
      SHAPE[I*3+7+J] := T;
      NXT[I*3+7+J] := I*3+8+J
    END;
    NXT[I*3+10] := I+4
  END;
  FOR I := 0 TO 9 DO
    QUOTA[I] := I*10+5;
  FOR I := 1 TO 4 DO BEGIN
    ERASE.G[I].EY := ORD(ESCCH) + 54400B;
    DRAW.G[I].EY := ORD(ESCCH) + 54400B;
    ERASE.G[I].CH := 27040B;
    DRAW.G[I].CH := 56533B
  END;
  ERASE.G[5].EY := ORD(ESCCH) + 54400B;
  DRAW.G[5].EY := ORD(ESCCH) + 54400B;
  ERASE.G[5].RC := 20040B;
  DRAW.G[5].RC := 20040B;
  ERASE.G[5].CH := 6415B;
  DRAW.G[5].CH := 6415B;
  EP := @ERASE;
  DP := @DRAW;
  ERAP := EP;
  DRWP := DP;
  FOR I := 1 TO 20 DO
    HIGH[I].NAME[1] := ' '
END;

PROCEDURE SIDEBR;
VAR I : INTEGER;
BEGIN
  WRITE(ESCCH, 'Y', CHR(53B), CHR(60B), '        ');
  WRITE(ESCCH, 'Y', CHR(54B), CHR(60B), '        ')
END;

PROCEDURE SHOWNX;
VAR I : INTEGER;
BEGIN
  SIDEBR;
  WITH SHAPE[NXTPC] DO
    FOR I := 1 TO 4 DO
      WRITE(ESCCH, 'Y', CHR(DY[I]+53B), CHR(DX[I]*2+64B), '[]');
  SCORE := SCORE - 5
END;

PROCEDURE NEWGAM;
VAR I, J : INTEGER;
BEGIN
  FOR I := 1 TO 10 DO
    FOR J := 1 TO 20 DO
      WELL[I][J] := CHR(0);
  FOR I := 1 TO 10 DO BEGIN
    WELL[I][0] := CHR(1);
    WELL[I][21] := CHR(1)
  END;
  FOR J := 0 TO 21 DO BEGIN
    WELL[0][J] := CHR(1);
    WELL[11][J] := CHR(1)
  END;
  FOR J := 0 TO 20 DO
    CNT[J] := 0;
  SCORE := 0;
  NXTPC := RANDOM(7)+1;
  SHOWN := FALSE;
  LINES := 0
END;

PROCEDURE DRAWFL(A, B : INTEGER);
VAR I, J : INTEGER;
BEGIN
  FOR J := A TO B DO BEGIN
    GOTOXY(27, J);
    FOR I := 1 TO 10 DO
      IF WELL[I][J] # CHR(0) THEN
        WRITE('[]')
      ELSE
        WRITE(' .')
  END
END;

FUNCTION CANFIT(X, Y : INTEGER) : BOOLEAN;
VAR K : INTEGER;
BEGIN
  CANFIT := TRUE;
  WITH CUR^ DO
    FOR K := 1 TO 4 DO
      IF WELL[X+DX[K], Y+DY[K]] # CHR(0) THEN BEGIN
        CANFIT := FALSE;
        EXIT
      END
END;

FUNCTION NEWPC : BOOLEAN;
VAR K : INTEGER;
BEGIN
  CURPC := NXTPC;
  NXTPC := RANDOM(7)+1;
  CUR := @SHAPE[CURPC];
  XPOS := 6;
  YPOS := 1;
  NEWPC := CANFIT(XPOS, YPOS);
  WITH CUR^ DO
    FOR CELL := 1 TO 4 DO BEGIN
      DRAW.G[CELL].RC := YPOS + 40B + DY[CELL] + ((XPOS + DX[CELL]) * 2 + 71B) * 400B;
      ERASE.G[CELL].RC := DRAW.G[CELL].RC
    END;
  WRITE(DRWP^.S);
  IF SHOWN THEN SHOWNX
END;

PROCEDURE MOVEDN;
BEGIN
  WRITE(ERAP^.S);
  IF CANFIT(XPOS, YPOS+1) THEN BEGIN
    FOR CELL := 1 TO 4 DO BEGIN
      DRAW.G[CELL].RC := DRAW.G[CELL].RC + 1;
      ERASE.G[CELL].RC := DRAW.G[CELL].RC
    END;
    YPOS := YPOS + 1
  END
  ELSE
    LANDED := TRUE;
  WRITE(DRWP^.S);
  SCORE := SCORE - 1
END;

PROCEDURE MOVELF;
BEGIN
  WRITE(ERAP^.S);
  IF CANFIT(XPOS-1, YPOS) THEN BEGIN
    FOR CELL := 1 TO 4 DO BEGIN
      DRAW.G[CELL].RC := DRAW.G[CELL].RC - 1000B;
      ERASE.G[CELL].RC := DRAW.G[CELL].RC
    END;
    XPOS := XPOS - 1;
    LANDED := FALSE
  END;
  WRITE(DRWP^.S)
END;

PROCEDURE MOVERT;
BEGIN
  WRITE(ERAP^.S);
  IF CANFIT(XPOS+1, YPOS) THEN BEGIN
    FOR CELL := 1 TO 4 DO BEGIN
      DRAW.G[CELL].RC := DRAW.G[CELL].RC + 1000B;
      ERASE.G[CELL].RC := DRAW.G[CELL].RC
    END;
    XPOS := XPOS + 1;
    LANDED := FALSE
  END;
  WRITE(DRWP^.S)
END;

PROCEDURE ROTPC;
VAR OLD : PSHP;
BEGIN
  OLD := CUR;
  CUR := @SHAPE[NXT[CURPC]];
  WRITE(ERAP^.S);
  IF CANFIT(XPOS, YPOS) THEN BEGIN
    WITH CUR^ DO
      FOR CELL := 1 TO 4 DO
        DRAW.G[CELL].RC := YPOS + 40B + DY[CELL] + ((XPOS + DX[CELL]) * 2 + 71B) * 400B;
    CURPC := NXT[CURPC];
    FOR CELL := 1 TO 4 DO
      ERASE.G[CELL].RC := DRAW.G[CELL].RC;
    LANDED := FALSE
  END
  ELSE
    CUR := OLD;
  WRITE(DRWP^.S)
END;

PROCEDURE DROP;
VAR START : INTEGER;
BEGIN
  START := YPOS;
  WHILE CANFIT(XPOS, YPOS+1) DO
    YPOS := YPOS + 1;
  FOR CELL := 1 TO 4 DO BEGIN
    ERASE.G[CELL].RC := DRAW.G[CELL].RC;
    DRAW.G[CELL].RC := DRAW.G[CELL].RC + (YPOS - START)
  END;
  WRITE(ERAP^.S);
  WRITE(DRWP^.S);
  LANDED := TRUE
END;

PROCEDURE CLRNXT;
VAR I : INTEGER;
BEGIN
  FOR I := 0 TO 6 DO BEGIN
    GOTOXY(52, I+2);
    WRITE(ESCCH, 'K')
  END
END;

PROCEDURE SPDUP;
BEGIN
  LEVEL := LEVEL + 1;
  PAUSE := PAUSE - 36B
END;

PROCEDURE KEY;
VAR C : CHAR;
BEGIN
  C := CHR(0);
(*$C
	EMT	^O340
	BCS	1$
	MOVB	%0,C(6)
1$:	EMT	^O340
	BCC	1$
*)
  CASE C OF
    ' ', '5' : DROP;
    '7' : MOVELF;
    '8' : ROTPC;
    '9' : MOVERT;
    '1' : BEGIN
            SHOWN := NOT SHOWN;
            IF SHOWN THEN
              SHOWNX
            ELSE
              SIDEBR
          END;
    '4' : IF LEVEL < 9 THEN SPDUP;
    '2', '3' : ;
    '0' : CLRNXT
  END
END;

PROCEDURE TITLE;
BEGIN
  CLS;
  GOTOXY(35, 6);
  WRITE('[ ]');
  GOTOXY(35, 7);
  WRITE(CHR(16B), 't e t r i s', CHR(17B));
  GOTOXY(43, 8);
  WRITE('[ ]');
  GOTOXY(20, 20);
  WRITE(CHR(16B), 'wa{ urowenx? (0-9) - ', CHR(17B));
  KEYIN(ANS);
  LEVEL := ORD(ANS) - ORD('0');
  IF LEVEL < 0 THEN
    LEVEL := 0;
  IF LEVEL > 9 THEN
    LEVEL := 9;
  PAUSE := LEVEL * (-36B) + 423B
END;

PROCEDURE LOCKPC;
VAR I : INTEGER;
BEGIN
  WITH CUR^ DO
    FOR I := 1 TO 4 DO BEGIN
      WELL[XPOS+DX[I], YPOS+DY[I]] := CHR(1);
      CNT[YPOS+DY[I]] := CNT[YPOS+DY[I]] + 1
    END;
  SCORE := SCORE + 25 + LEVEL*3
END;

PROCEDURE CLRROW;
LABEL 2;
VAR I, SRC, BOT, K, DST, J : INTEGER;
BEGIN
  DST := 0;
  FOR I := 20 DOWNTO 1 DO
    IF CNT[I] = 10 THEN BEGIN
      DST := I;
      EXIT
    END;
  IF DST = 0 THEN GOTO 2;
  BOT := DST;
  SRC := DST;
  WHILE (CNT[SRC] # 0) AND (SRC > 0) DO BEGIN
    IF CNT[SRC] # 10 THEN BEGIN
      FOR J := 1 TO 10 DO
        WELL[J][DST] := WELL[J][SRC];
      CNT[DST] := CNT[SRC];
      DST := DST - 1
    END
    ELSE BEGIN
      GOTOXY(27, SRC);
      FOR I := 1 TO 10 DO
        WRITE(' .');
      LINES := LINES + 1;
      IF (LINES > QUOTA[LEVEL]) AND (LEVEL < 9) THEN BEGIN
        WRITE(CHR(7));
        SPDUP
      END
    END;
    SRC := SRC - 1
  END;
  FOR K := SRC+1 TO DST DO BEGIN
    FOR J := 1 TO 10 DO
      WELL[J][K] := CHR(0);
    CNT[K] := 0
  END;
  DRAWFL(SRC, BOT);
2: END;

PROCEDURE REPORT;
VAR T : INTEGER;
BEGIN
  GOTOXY(0, 0);
  WRITE(CHR(16B), '
polnyh strok:', LINES:3, '
urowenx:     ', LEVEL:3, '
  s~et:  ', SCORE MOD 1000 :3, CHR(17B));
  WRITELN;
  FOR T := 1 TO SCORE DIV 1000 DO BEGIN
    WRITE(' $');
    IF T MOD 5 = 0 THEN
      WRITELN
  END
END;

PROCEDURE HELP;
VAR I : INTEGER;
BEGIN
  FOR I := 1 TO 20 DO BEGIN
    GOTOXY(25, I);
    WRITE('<! . . . . . . . . . .!>')
  END;
  GOTOXY(25, 21);
  WRITE('<!====================!>');
  GOTOXY(25, 22);
  WRITE('  \/\/\/\/\/\/\/\/\/\/');
  GOTOXY(52, 2);
  WRITE(CHR(16B), '7: nalewo   9: naprawo');
  GOTOXY(52, 3);
  WRITE('     8:poworot ');
  GOTOXY(52, 4);
  WRITE('4:uskoritx  5:sbrositx');
  GOTOXY(52, 5);
  WRITE('1: pokazatx  sledu`}u`');
  GOTOXY(52, 6);
  WRITE('0:  steretx |tot tekst');
  GOTOXY(52, 7);
  WRITE('  probel - sbrositx', CHR(17B))
END;

BEGIN
  ESCCH := CHR(33B);
  FILLCH := CHR(11B);
  WRITE(CHR(27B), CHR(17B));
  SETUP;
  TICKS := 60B;
1:
  TITLE;
  NEWGAM;
  CLS;
  HELP;
  REPORT;
  JSW := JSW OR 10100B;
  WHILE NEWPC DO BEGIN
    LANDED := FALSE;
    REPEAT
      WAIT(TICKS, PAUSE);
      KEY;
      MOVEDN;
      KEY
    UNTIL LANDED;
    LOCKPC;
    CLRROW;
    REPORT
  END;
  WRITE(CHR(7));
(*$C
1$:	EMT	^O340
	BCC	1$
*)
  SCORES(LEVEL, SCORE);
  GOTOXY(12, 23);
  WRITE(CHR(16B), 'e}e parti`? (da/net) - ');
  READ(ANS);
  READLN;
  WRITE(CHR(17B));
  IF (ANS = 'd') OR (ANS = 'D') THEN GOTO 1
END.
